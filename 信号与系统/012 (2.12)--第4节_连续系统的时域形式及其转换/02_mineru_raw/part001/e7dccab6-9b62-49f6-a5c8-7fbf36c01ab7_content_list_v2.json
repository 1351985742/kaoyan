        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "取中间变量  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\rightarrow"
                    },
                    {
                        "type": "text",
                        "content": " 使中间变量与输入满足方程左端形式【  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "e(t) ="
                    },
                    {
                        "type": "text",
                        "content": " 】  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\rightarrow"
                    },
                    {
                        "type": "text",
                        "content": " 则中间变量与输出满足右端形式【  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "r(t) ="
                    },
                    {
                        "type": "text",
                        "content": " 】"
                    }
