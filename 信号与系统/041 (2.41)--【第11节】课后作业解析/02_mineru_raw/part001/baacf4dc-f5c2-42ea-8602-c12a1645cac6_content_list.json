    {
        "type": "equation",
        "text": "$$\n\\begin{array}{r l} {\\int_ {- \\infty} ^ {\\infty} | h (t) | d t} & {= \\int_ {- \\infty} ^ {\\infty} | - 5 e ^ {- t} + 4 e ^ {- x t} | u (t) d t = \\int_ {0} ^ {\\infty} | - 5 e ^ {- t} + 4 e ^ {- x t} | d t} \\\\ & {\\leq \\int_ {0} ^ {\\infty} | - 5 e ^ {- t} | d t + \\int_ {0} ^ {\\infty} | 4 e ^ {- 2 t} | d t} \\\\ & {= 5 \\int_ {0} ^ {\\infty} e ^ {- t} d t + 4 \\int_ {0} ^ {\\infty} e ^ {- x t} d t} \\\\ & {= 5 [ - e ^ {- t} ] _ {0} ^ {\\infty} + 4 [ - \\frac {1}{2} e ^ {- 2 t} ] _ {0} ^ {\\infty}} \\\\ & {= 5 [ 0 + 1 ] - 2 [ 0 - 1 ]} \\\\ & {= 7 <   \\infty \\quad \\mathrm{故系统稳定}} \\end{array}\n$$",
