        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "3、求下列函数的逆变换。"
                    }
                ]
            },
            "bbox": [
                144,
                85,
                374,
                102
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "(1) X (s) = \\frac {2 s ^ {3} + 8 s ^ {2} + 4 s + 8}{s (s + 1) \\left(s ^ {2} + 4 s + 8\\right)}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/2164ec6c513e4b3f2bbe6c95bfafaa2fa3981f645fed204b699af1134df0ce11.jpg"
                }
            },
            "bbox": [
                147,
                111,
                359,
                143
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "(2) X (s) = \\frac {4}{(s + 1) (s + 2) ^ {3}}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/1bca53d145c03a05417688b6b5015c027b2c55eb796c55f57abb5926fc988ddc.jpg"
                }
            },
            "bbox": [
                147,
                149,
                329,
                179
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(3)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "X(s) = \\frac{s^2 + 4s + 2}{(s + 1)(s + 2)}"
                    }
                ]
            },
            "bbox": [
                147,
                185,
                321,
                217
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(4)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "X(s)=\\frac{se^{-2s}+1}{(s+1)(s+2)}"
                    }
                ]
            },
            "bbox": [
                147,
                223,
                321,
                254
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(5)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "X(s) = \\frac{1}{(s + 1)(s^2 + 4)}"
                    }
                ]
            },
            "bbox": [
                147,
                259,
                329,
                290
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(6)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "X(s) = \\frac{1}{1 + e^{-2s}}"
                    }
                ]
            },
            "bbox": [
