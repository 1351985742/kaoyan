            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1、求下列函数的拉普拉斯逆变换。"
                    }
                ]
            },
            "bbox": [
                144,
                117,
                455,
                135
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(1)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{3}{(s + 4)(s + 2)}"
                    }
                ]
            },
            "bbox": [
                147,
                143,
                265,
                173
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(2)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{3s}{(s + 4)(s + 2)}"
                    }
                ]
            },
            "bbox": [
                147,
                179,
                265,
                208
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(3)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{1}{(s^2 + 3)^2}"
                    }
                ]
            },
            "bbox": [
                147,
                214,
                245,
                247
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(4)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{e^{-s}}{4s(s^2 + 1)}"
                    }
                ]
            },
            "bbox": [
                147,
                252,
                252,
                282
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(5)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\ln \\left( \\frac{s}{s + 9} \\right)"
                    }
                ]
            },
            "bbox": [
                147,
                288,
                257,
                317
            ]
        },
