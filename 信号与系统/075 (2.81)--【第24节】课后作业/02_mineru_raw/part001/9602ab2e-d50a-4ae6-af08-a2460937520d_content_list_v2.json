        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "2、下列象函数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "F(s)"
                    },
                    {
                        "type": "text",
                        "content": " 的原函数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(t)"
                    },
                    {
                        "type": "text",
                        "content": " 是t=0接入的有始周期信号，求周期T并写出其第一个周期  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "(0<t<T)"
                    },
                    {
                        "type": "text",
                        "content": " 的时间函数表达式  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f_{0}(t)"
                    },
                    {
                        "type": "text",
                        "content": " 。"
                    }
                ]
            },
            "bbox": [
                144,
                85,
                848,
                131
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(1)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{1}{s(1 + e^{-2s})}"
                    }
                ]
            },
            "bbox": [
                147,
                139,
                248,
                168
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(2)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{\\pi(1 + e^{-s})}{(s^2 + \\pi^2)(1 - e^{-s})}"
                    }
                ]
            },
            "bbox": [
                147,
                175,
                287,
                205
            ]
