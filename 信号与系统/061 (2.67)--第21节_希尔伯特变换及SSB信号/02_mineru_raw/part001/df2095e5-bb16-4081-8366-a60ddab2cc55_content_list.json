    {
        "type": "page_number",
        "text": "25",
        "bbox": [
            487,
            928,
            509,
            940
        ],
        "page_idx": 5
    },
    {
        "type": "footer",
        "text": "官网：tongxinkaoyan.com",
        "bbox": [
            117,
