        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {H [ a _ {1} f _ {1} | t | + a _ {2} f _ {2} | t | ] =} & {a _ {1} f _ {1} (\\frac {t}{2}) + a _ {2} \\frac {f _ {1} (\\frac {t}{2})}{2} ①} \\\\ {a _ {1} y _ {1} | t | + a _ {2} y _ {2} | t | =} & {a _ {1} f _ {1} (\\frac {t}{2}) + a _ {2} f _ {2} (\\frac {t}{2}) ②} \\end{array}",
