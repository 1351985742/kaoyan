        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "判断该系统是否是线性、时不变、因果、无记忆性、稳定系统。"
                    }
                ]
            },
            "bbox": [
                181,
                155,
                685,
                173
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "反应作用: [让液后中  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "t \\rightarrow  {2t}"
                    },
                    {
                        "type": "text",
                        "content": " ] + [让液后中  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "t \\rightarrow  {t - 1}"
                    },
                    {
                        "type": "text",
                        "content": " ]"
                    }
                ]
            },
            "bbox": [
                176,
                169,
                707,
                218
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {H [ a _ {1} f _ {1} (t) + a _ {2} f _ {2} (t) ]} & {= [ a _ {1} f _ {1} (t) + a _ {2} f _ {2} (t) ] + [ a _ {1} f _ {1} (t - 1) + a _ {2} f _ {2} (t - 1) ] \\textcircled {1}} \\\\ {a _ {1} y _ {1} (t) + a _ {2} y _ {2} (t)} & {= a _ {1} [ f _ {1} (2 t) + f _ {1} (t - 1) ] + a _ {2} [ f _ {2} (2 t) + f _ {2} (t - 1) ] \\textcircled {2}} \\\\ {H [ f (t - t _ {0}) ]} & {= f (2 t - t _ {0}) + f (t - 1 - t _ {0}) \\textcircled {3}} \\\\ {y (t - t _ {0})} & {= f [ 2 (t - t _ {0}) ] + f (t - t _ {0} - 1) \\textcircled {4}} \\\\ {\\textcircled {1}} & {= \\textcircled {2}, \\textcircled {3} \\neq \\textcircled {4} \\mathrm{故为线性,时变系统}} \\end{array}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/3c6cf37bae6bbfeea4401e889ee7df4d9eea4a6ea2c2a72e18afcbdf0d6c3222.jpg"
                }
            },
            "bbox": [
                171,
                217,
                873,
                423
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "令t=1 则   "
