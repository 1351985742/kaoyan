                642
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "说明此系统是否为线性非时变记忆因果系统。a和b为常数。"
                    }
                ]
            },
            "bbox": [
                184,
                647,
                648,
                663
            ]
        },
        {
