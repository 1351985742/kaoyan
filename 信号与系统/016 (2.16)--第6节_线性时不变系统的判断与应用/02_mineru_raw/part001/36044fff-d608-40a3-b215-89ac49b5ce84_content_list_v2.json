        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(1)给定输入之间的关系和某一响应，求解另外一个响应"
                    }
                ]
            },
            "bbox": [
                184,
