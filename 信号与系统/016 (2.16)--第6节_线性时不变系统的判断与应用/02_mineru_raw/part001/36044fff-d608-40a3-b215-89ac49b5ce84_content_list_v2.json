        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "例 36: 有一线性时不变系统, 当激励  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "e_{1}(t)=u(t)"
                    },
                    {
                        "type": "text",
                        "content": " 时, 响应  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "r_{1}(t)=e^{-\\alpha t}u(t)"
                    },
                    {
                        "type": "text",
                        "content": " , 试求当激励  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "e_{2}(t)=\\delta(t)"
                    },
                    {
                        "type": "text",
                        "content": " 时, 响应  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "r_{2}(t)"
                    },
                    {
                        "type": "text",
                        "content": " 的表示式。(假定起始时刻系统无储能。)"
                    }
                ]
            },
            "bbox": [
                183,
                157,
                811,
