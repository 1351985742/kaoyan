                600,
                190
            ]
        },
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "考点3：线性时不变系统的特性与应用"
                    }
                ],
                "level": 2
            },
            "bbox": [
                184,
                542,
                544,
                560
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1、LTIS的线性性质—系统(零状态)响应与外加激励"
                    }
                ]
            },
            "bbox": [
                184,
                570,
                594,
                586
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "对于线性系统而言，当系统外加激励发生线性变化时，其对应的(零状态)响应发生相同形式的变化。"
                    }
                ]
            },
            "bbox": [
                184,
                595,
                810,
                635
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "例如："
                    }
                ]
            },
            "bbox": [
                184,
                644,
                236,
                659
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "f (t) \\stackrel {H} {\\to} y (t)",
                "math_type": "latex",
                "image_source": {
                    "path": "images/9e92b91daa153d835c2bb60547d3e1e0c25db641f9851754dfdb6143be0f099e.jpg"
                }
            },
            "bbox": [
                450,
                666,
                544,
                691
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "则"
                    }
                ]
            },
            "bbox": [
                184,
                697,
                210,
                712
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "2 f _ {1} (t) + 3 f _ {2} (t) \\xrightarrow {H}?",
                "math_type": "latex",
                "image_source": {
                    "path": "images/c0cbe430d6ac0af615d86da63579404ca33de5e33d42591c41144b657199f266.jpg"
                }
            },
            "bbox": [
                411,
                720,
                576,
                744
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "故答案应为  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "2y_{1}(t) + 3y_{2}(t)"
                    },
                    {
                        "type": "text",
                        "content": "。"
                    }
                ]
            },
            "bbox": [
                184,
                750,
                413,
                767
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
