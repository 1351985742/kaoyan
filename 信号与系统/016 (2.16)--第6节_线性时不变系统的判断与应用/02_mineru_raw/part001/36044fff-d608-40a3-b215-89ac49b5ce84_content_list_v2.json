        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "例 35: 已知   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(t)"
                    },
                    {
                        "type": "text",
                        "content": "  为系统的输入,   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y(t)"
                    },
                    {
                        "type": "text",
                        "content": "  为系统的输出, 试判断下列系统是否为线性、时不变系统。"
                    }
                ]
            },
            "bbox": [
                181,
                108,
                811,
                149
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\frac {d y (t)}{d t} + a (t) y (t) = \\frac {d f (t)}{d t}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/557332267c2ac65891407e640b029d025ab98def32e1a5da0895075bac875d94.jpg"
                }
            },
            "bbox": [
                394,
