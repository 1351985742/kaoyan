            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "y _ {z i} (t) = A _ {1} e ^ {- t} + A _ {2} e ^ {- 2 t}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/0b7cdf339ff28ccb17c6400a21ee310cad34cf5ccef248ae122cf7d0c881df2b.jpg"
