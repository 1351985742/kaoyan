            },
            "bbox": [
                147,
                516,
                366,
                533
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(3)零状态响应的解形式: 左边方程+激励  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\Rightarrow y_{zs}(t)"
                    },
                    {
                        "type": "text",
                        "content": " 解形式一般性"
                    }
                ]
            },
            "bbox": [
                147,
                539,
