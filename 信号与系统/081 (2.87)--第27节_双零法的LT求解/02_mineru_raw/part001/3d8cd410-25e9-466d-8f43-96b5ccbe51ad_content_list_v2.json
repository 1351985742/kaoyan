        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} & {H (s) = \\frac {\\text {右边}}{\\text {左边}} = \\frac {s + 1}{s ^ {2} + 3 s + 2} = \\frac {s + 1}{(s + 1) (s + 2)} = \\frac {1}{(s + 2)}} \\\\ & {\\qquad \\Rightarrow Y _ {z s} (s) = H (s) \\cdot F (s) = \\frac {1}{(s + 2)} \\cdot \\frac {1}{(s + 3)}} \\\\ & {\\qquad \\Rightarrow y _ {z s} (t) = (e ^ {- 2 t} - e ^ {- 3 t}) u (t)} \\end{array}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/43a242c6ede228941d3d9227772ba4735b5a482087834a7450b7862fa0fee253.jpg"
