        {
            "type": "equation_interline",
            "content": {
                "math_content": "y _ {z s} (t) = A _ {3} e ^ {- 3 t} + A _ {4} e ^ {- 2 t} + B e ^ {- 3 t}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/6b5e9a790fe010b8644099276cbf352e56a997a760572824bafc6de591923598.jpg"
