        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\text {微分方程} \\rightarrow \\left\\{\\begin{array}{l l}\\text {已知} r ^ {(k)} (0 _ {-})&\\left[\\begin{array}{l}\\text {时域} r _ {z i} (t)\\\\\\text {LT} r _ {z s} (t)\\end{array}\\right]\\rightarrow r (t) = r _ {z i} (t) + r _ {z s} (t)\\\\\\text {已知} r ^ {(k)} (0 _ {+})&\\left[\\begin{array}{l}\\text {LT求} r _ {z s} (t) \\xrightarrow [ \\text {特解} ]{\\text {解形式}} \\text {时域} r (t) \\xrightarrow [ (\\text {含系数}) ]{r ^ {(k)} (0 _ {+})} r (t) \\xrightarrow [ r _ {z i} (t) = r (t) - r _ {z s} (t) ]{\\text {时域}:}\\\\\\text {设} r _ {z i} (t) \\text {解(含系数)} \\rightarrow r (t) \\text {完全(含系数)} \\xrightarrow {r ^ {(k)} (0 _ {+})} r _ {z i} (t) \\text {和} r (t)\\end{array}\\right.\\end{array}\\right.",
                "math_type": "latex",
                "image_source": {
                    "path": "images/82ee87f05a59ad4d81d023585dcfa03eb8a120ee0d061115150ab53152717aec.jpg"
