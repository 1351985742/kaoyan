                346,
                104
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\text {以} y ^ {\\prime \\prime} (t) + 3 y ^ {\\prime} (t) + 2 y (t) = f ^ {\\prime} (t) + f (t), f (t) = e ^ {- 3 t} u (t), y (0 _ {-}) = 1, y ^ {\\prime} (0 _ {-}) = 1",
                "math_type": "latex",
                "image_source": {
                    "path": "images/25a6061e0cdfc2e65c6af2b6fe398183f2f58d1a5c0a1d45b28a77ccfd5bdaca.jpg"
