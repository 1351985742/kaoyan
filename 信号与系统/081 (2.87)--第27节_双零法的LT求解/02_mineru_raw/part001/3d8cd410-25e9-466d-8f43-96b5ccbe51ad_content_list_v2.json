            },
            "bbox": [
                147,
                563,
                347,
                580
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(5) 系统函数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\leftrightarrow"
                    },
                    {
                        "type": "text",
                        "content": " 微分方程"
                    }
                ]
            },
            "bbox": [
                147,
                586,
                369,
                602
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "以  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y''(t)+3y'(t)+2y(t)=f'(t)+4f(t)"
                    },
                    {
                        "type": "text",
                        "content": " 为例："
                    }
                ]
            },
            "bbox": [
                147,
                608,
                549,
                627
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} & {\\text {①} f (t) = e ^ {- 3 t} u (t)} \\\\ & {\\qquad \\Rightarrow y _ {z i} (t) = A _ {1} e ^ {- t} + A _ {2} e ^ {- 2 t} \\Rightarrow y _ {z s} (t) = A _ {3} e ^ {- t} + A _ {4} e ^ {- 2 t} + B e ^ {- 3 t}} \\end{array}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/47fe1182577f29cb50a2d19037c4fd751b4d66052f556a4ffd82783d2544f7b6.jpg"
