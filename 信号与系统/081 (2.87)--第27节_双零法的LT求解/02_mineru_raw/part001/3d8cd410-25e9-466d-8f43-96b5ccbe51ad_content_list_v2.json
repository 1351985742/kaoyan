            "content": {
                "math_content": "\\begin{array}{r l} & {\\text {②} f (t) = e ^ {- 2 t} u (t)} \\\\ & {\\qquad \\Rightarrow y _ {z i} (t) = A _ {1} e ^ {- t} + A _ {2} e ^ {- 2 t} \\Rightarrow y _ {z s} (t) = A _ {3} e ^ {- t} + A _ {4} e ^ {- 2 t} + B t e ^ {- 2 t}} \\end{array}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/0169589eb5f4d531e0cbb6b4f77d3c79589af45c6c1d47cc415ab9c09c7d66f0.jpg"
