            453,
            127
        ],
        "page_idx": 6
    },
    {
        "type": "text",
        "text": "1、 $h(t)$ 可以表征系统",
        "bbox": [
            184,
            137,
            359,
            154
        ],
        "page_idx": 6
    },
    {
        "type": "text",
        "text": "2、 $h(t)$ 判断系统特性",
        "bbox": [
            184,
            162,
            359,
            178
        ],
        "page_idx": 6
    },
    {
        "type": "text",
        "text": "(1)因果: $t < 0$ 时, $h(t) = 0$",
        "bbox": [
