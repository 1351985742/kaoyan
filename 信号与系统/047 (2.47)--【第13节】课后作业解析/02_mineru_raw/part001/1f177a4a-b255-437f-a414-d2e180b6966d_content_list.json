    {
        "type": "equation",
        "text": "$$\n\\begin{array}{r l} {\\mathrm{即} y | t |} & {= x _ {1} | t | * x _ {2} (\\frac {t}{2})} \\\\ & {= e ^ {- 2 t} u | t | * [ u | t | - u (t - 4) ]} \\end{array}\n$$",
        "text_format": "latex",
        "bbox": [
            220,
            290,
            571,
            355
        ],
        "page_idx": 0
    },
    {
        "type": "image",
        "img_path": "images/f74728ecfe2e3dc3b78f743c442d4b65ad2c25b650d73fd69d35e7253ba4fb9a.jpg",
        "image_caption": [],
        "image_footnote": [],
        "content": "",
        "bbox": [
            707,
            256,
            924,
            331
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\n\\begin{array}{r l} {e ^ {- i t} u (t)} & {\\times u (t) = \\int_ {0} ^ {t} e ^ {- 2 \\tau} d \\tau \\cdot u (t)} \\\\ & {= - \\frac {1}{2} e ^ {- 2 \\tau} \\bigg / _ {0} ^ {t} \\cdot u (t)} \\\\ & {= - \\frac {1}{2} [ e ^ {- i t} - 1) u (t)} \\end{array}\n$$",
        "text_format": "latex",
        "bbox": [
            240,
            362,
            586,
            489
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\n\\begin{array}{r l} {\\int_ {0} ^ {t} e ^ {- 2 \\tau} d \\tau} & {= - \\frac {1}{2} e ^ {- 2 \\tau} / _ {0} ^ {t}} \\\\ & {= - \\frac {1}{2} (e ^ {- t} - 1)} \\end{array}\n$$",
        "text_format": "latex",
        "bbox": [
            705,
            333,
            924,
            410
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\n2 ^ {0} t \\geq 4\n$$",
        "text_format": "latex",
        "bbox": [
            640,
            435,
            719,
            465
        ],
        "page_idx": 0
    },
    {
        "type": "image",
        "img_path": "images/9d61e60d4d1bc4c1aeb674120bf6807f0df4e98f57fc4f5d89f2eb21a09c3cd0.jpg",
