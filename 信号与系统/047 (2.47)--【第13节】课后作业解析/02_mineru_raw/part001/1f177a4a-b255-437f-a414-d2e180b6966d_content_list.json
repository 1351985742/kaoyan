    {
        "type": "equation",
        "text": "$$\n\\mathrm{故} y (t) = - \\frac {1}{2} (e ^ {- x t} - 1) u (t) + \\frac {1}{2} [ e ^ {- 2 (t - 4)} - 1 ] u (t - 4)\n$$",
        "text_format": "latex",
        "bbox": [
            213,
            495,
            648,
            535
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\n\\begin{array}{r l} {\\int_ {t - 4} ^ {t} e ^ {- 2 \\tau} d \\tau} & {= - \\frac {1}{2} e ^ {- 2 \\tau} / t - 4} \\\\ & {= - \\frac {1}{2} [ e ^ {- 2 t} - e ^ {- 2 (t - 4)} ]} \\\\ & {= - \\frac {1}{4} e ^ {- 2 t} + \\frac {1}{2} e ^ {- 2 (t - 4)}} \\end{array}\n$$",
        "text_format": "latex",
        "bbox": [
            697,
