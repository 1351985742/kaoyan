[
    {
        "type": "text",
        "text": "专题2 拉氏逆变换",
        "text_level": 2,
        "bbox": [
            391,
            85,
            608,
            105
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "$F(s)=\\frac{\\text{分子关于}s\\text{多项式}}{\\text{分母关于}s\\text{多项式}}=\\frac{A(s)}{B(s)},\\quad A(s)=0\\text{的点称为}F(s)\\text{的零点},\\quad B(s)=0\\text{的点称为}F(s)\\text{的极点}$",
        "bbox": [
            147,
            118,
            934,
            159
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "部分分式展开法原理：",
        "bbox": [
            147,
            185,
            344,
            202
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\nF (s) = \\sum_ {k} A _ {k} \\frac {1}{s + s _ {k}} \\rightarrow f (t) = \\sum_ {k} A _ {k} e ^ {- s _ {k} t}\n$$",
        "text_format": "latex",
        "bbox": [
            336,
            210,
            658,
            239
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\n\\begin{array}{c} {F (s) = \\frac {2 s + 3}{s (s + 1)} = \\frac {k _ {0}}{s} + \\frac {k _ {1}}{s + 1} = \\frac {3}{s} + \\frac {- 1}{s + 1}} \\\\ {\\Rightarrow f (t) = 3 u (t) - e ^ {- t} u (t)} \\end{array}\n$$",
        "text_format": "latex",
        "bbox": [
            315,
            288,
            682,
            348
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "①求 $k_{0}$ ：两边同乘以s",
        "bbox": [
            146,
            351,
            344,
            370
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\n\\mathrm{令} s = 0\n$$",
        "text_format": "latex",
        "bbox": [
            147,
            444,
            220,
            462
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "夢馬考研",
        "bbox": [
            426,
            502,
            600,
            537
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "②求 $k_{1}$ :",
        "bbox": [
            144,
            537,
            221,
            555
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "两边同乘以 $s + 1$ ，得",
        "bbox": [
            146,
            560,
            337,
            577
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "令 $s = -1$",
        "bbox": [
            146,
            677,
            233,
            693
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "建议步骤如下：",
        "bbox": [
            146,
            774,
            282,
            793
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\nF (s) = \\frac {2 s + 3}{s (s + 1)} = \\frac {k _ {0}}{s} + \\frac {k _ {1}}{s + 1}\n$$",
        "text_format": "latex",
        "bbox": [
            336,
            770,
            546,
            799
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\n\\left(k _ {0} = s f (s) \\right| _ {s = 0} = \\frac {2 s + 3}{s + 1} \\Big | _ {s = 0} = \\frac {3}{1} = 3\n$$",
        "text_format": "latex",
        "bbox": [
            267,
            802,
            600,
            840
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\n\\left\\{k _ {1} = (s + 1) f (s) \\big | _ {s = - 1} = \\frac {2 s + 3}{s} \\right| _ {s = - 1} = \\frac {- 2 + 3}{- 1} = - 1\n$$",
        "text_format": "latex",
        "bbox": [
            265,
            839,
            734,
            878
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\n\\therefore f (t) = 3 u (t) - e ^ {- t} u (t)\n$$",
        "text_format": "latex",
        "bbox": [
            386,
            879,
            610,
            898
        ],
        "page_idx": 0
    },
    {
        "type": "header",
