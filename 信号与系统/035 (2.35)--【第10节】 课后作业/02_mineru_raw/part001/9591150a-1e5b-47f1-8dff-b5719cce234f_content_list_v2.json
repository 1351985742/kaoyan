                    {
                        "type": "text",
                        "content": " 时, 全响应  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{1}(t) = (e^{-t} + \\cos \\pi t)u(t)"
                    },
                    {
                        "type": "text",
