                    {
                        "type": "equation_inline",
                        "content": "y(0_{-}) = 2"
                    },
                    {
                        "type": "text",
                        "content": ", 激励为因果信号  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "3f(t)"
                    },
                    {
                        "type": "text",
                        "content": " 时, 全响应  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{2}(t) = 2\\cos \\pi tu(t)"
                    },
                    {
                        "type": "text",
                        "content": ", 利用时域分析方法求  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y(0_{-}) = -2"
                    },
                    {
                        "type": "text",
                        "content": ", 激励为因果信号  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "3f'(t) + f(t - 1)"
                    },
                    {
                        "type": "text",
                        "content": " 时, 全响应  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{3}(t)"
                    },
                    {
                        "type": "text",
                        "content": "。"
