                0.171,
                0.829,
                0.587,
                0.88
            ],
            "angle": 0,
            "content": "故  \\( y(t)=\\frac{3}{2}\\sin200\\pi t+\\frac{9}{2}\\sin400\\pi t \\)",
            "merge_prev": false
        },
