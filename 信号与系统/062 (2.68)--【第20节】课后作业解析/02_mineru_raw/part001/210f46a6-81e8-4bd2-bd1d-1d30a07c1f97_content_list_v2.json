        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "由于  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "Y(w) = x_1(w) \\cdot H(w)"
                    },
                    {
                        "type": "text",
                        "content": "，其中  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "H(w)"
                    },
                    {
                        "type": "text",
                        "content": " 频域范围为 -400π 到 400π"
                    }
                ]
            },
            "bbox": [
                149,
                465,
                905,
                524
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
