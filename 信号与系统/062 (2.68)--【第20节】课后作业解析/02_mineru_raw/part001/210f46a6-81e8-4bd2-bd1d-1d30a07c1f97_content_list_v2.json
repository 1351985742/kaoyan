                391
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\therefore x _ {1} (w) = \\frac {x (w)}{2} - \\frac {1}{4} [ x (w + 8 0 0 \\pi) + x (w - 8 0 0 \\pi) ]",
                "math_type": "latex",
                "image_source": {
                    "path": "images/e6e60b5addf042e1203d81cbc28cb0e518b4792c30791b257fd5bc6e52a9d28c.jpg"
