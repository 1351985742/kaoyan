            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "equation_inline",
                        "content": "\\sqrt{2}x_{1}|t|=x_{1}|t\\cdot\\sin^{2}400\\tan t=x_{1}|t"
                    }
                ]
            },
            "bbox": [
                112,
                369,
                536,
                416
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\frac {1 - \\cos 8 0 0 \\pi t}{2} = \\frac {\\lambda (t)}{2} - \\frac {1}{2} \\lambda (t) \\cdot \\cos 8 0 0 \\pi t",
                "math_type": "latex",
                "image_source": {
                    "path": "images/19309216309cf939debf5382b69cb46c8b055d3e3192ac6105461681eae97aad.jpg"
                }
            },
            "bbox": [
                566,
