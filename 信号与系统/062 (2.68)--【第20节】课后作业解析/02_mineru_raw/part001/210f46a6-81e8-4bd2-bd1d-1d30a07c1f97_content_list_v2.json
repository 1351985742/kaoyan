                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1. 解:  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\because x(t) = \\sin 200\\pi t + 2\\sin 400\\pi t"
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\therefore x(w) = j\\pi [\\sqrt{w + 200\\pi} + \\sqrt{w - 200\\pi}] + 2j\\pi [\\sqrt{w + 400\\pi} + \\sqrt{w - 400\\pi}]"
                    }
                ]
            },
            "bbox": [
