        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\sin^ {2} 4 0 0 \\pi t = \\frac {1 - \\cos 8 0 0 \\pi t}{2}",
                "math_type": "latex",
                "image_source": {
