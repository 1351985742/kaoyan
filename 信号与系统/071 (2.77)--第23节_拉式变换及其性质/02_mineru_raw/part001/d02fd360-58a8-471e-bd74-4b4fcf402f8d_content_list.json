        ],
        "table_footnote": [],
        "table_body": "<table><tr><td>常见信号表达式</td><td>常见信号的拉氏变换结果</td></tr><tr><td> $\\delta(t)$ </td><td>1</td></tr><tr><td> $\\delta^{(n)}(t)$ </td><td> $s^n$ </td></tr><tr><td>u(t)</td><td> $\\frac{1}{s}$ </td></tr><tr><td>直流分量E</td><td> $\\frac{E}{s}$ </td></tr><tr><td> $t^n(n \\text{是正整数})$ </td><td> $\\frac{n!}{s^{n+1}}$ </td></tr><tr><td>sin ωtu(t)</td><td> $\\frac{\\omega}{s^2 + \\omega^2}$ </td></tr><tr><td>cos ωtu(t)</td><td> $\\frac{s}{s^2 + \\omega^2}$ </td></tr><tr><td> $Ee^{-\\alpha t}u(t)$ </td><td> $\\frac{E}{s + \\alpha}$ </td></tr><tr><td> $Ete^{-\\alpha t}u(t)$ </td><td> $\\frac{E}{(s + \\alpha)^2}$ </td></tr><tr><td> $Et^2 e^{-\\alpha t}u(t)$ </td><td> $\\frac{2E}{(s + \\alpha)^3}$ </td></tr><tr><td> $\\sum_{n=0}^{\\infty} \\delta(t - nT)$ </td><td> $\\frac{1}{1 - e^{-sT}}$ </td></tr><tr><td> $\\sum_{n=0}^{\\infty} f_0(t - nT)$ </td><td> $\\frac{F_0(s)}{1 - e^{-sT}}$ </td></tr></table>",
