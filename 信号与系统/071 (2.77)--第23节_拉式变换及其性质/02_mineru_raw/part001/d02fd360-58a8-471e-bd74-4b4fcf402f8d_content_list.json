    },
    {
        "type": "text",
        "text": "考点4：LT变换的性质",
        "text_level": 2,
        "bbox": [
            147,
            85,
            388,
            105
        ],
        "page_idx": 4
    },
    {
        "type": "text",
        "text": "1、线性——复合信号分解为多个常见信号",
        "bbox": [
            144,
            120,
            526,
            137
        ],
        "page_idx": 4
    },
    {
        "type": "text",
        "text": "例子：",
        "bbox": [
            144,
            143,
            201,
            159
        ],
        "page_idx": 4
    },
    {
        "type": "equation",
        "text": "$$\n\\sin \\omega_ {0} t u (t) = \\frac {e ^ {j \\omega_ {0} t} - e ^ {- j \\omega_ {0} t}}{2 j} u (t); \\cos \\omega_ {0} t u (t) = \\frac {e ^ {j \\omega_ {0} t} + e ^ {- j \\omega_ {0} t}}{2} u (t)\n$$",
        "text_format": "latex",
        "bbox": [
            203,
            165,
            751,
            199
        ],
        "page_idx": 4
    },
    {
        "type": "equation",
        "text": "$$\ne ^ {j \\omega_ {0} t} u (t) \\leftrightarrow \\frac {1}{s - j \\omega_ {0}}; e ^ {- j \\omega_ {0} t} u (t) \\leftrightarrow \\frac {1}{s + j \\omega_ {0}}\n$$",
        "text_format": "latex",
        "bbox": [
            305,
            200,
            690,
            237
        ],
