    {
        "type": "text",
        "text": "考点3：常见信号的单边拉氏变换",
        "text_level": 2,
        "bbox": [
            146,
            85,
            504,
            105
        ],
        "page_idx": 3
    },
    {
        "type": "text",
        "text": "1、冲激信号的 LT",
        "bbox": [
            144,
            120,
            312,
            137
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\n\\delta (t) \\leftrightarrow 1\n$$",
        "text_format": "latex",
        "bbox": [
            470,
            143,
            554,
            161
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\n\\int_ {0 _ {-}} ^ {\\infty} \\delta (t) e ^ {- s t} d t = f (0) = 1\n$$",
        "text_format": "latex",
        "bbox": [
            394,
            170,
            630,
            211
        ],
        "page_idx": 3
    },
    {
        "type": "text",
        "text": "2、冲激偶信号的 LT",
        "bbox": [
            144,
            222,
            332,
            239
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\n\\delta^ {\\prime} (t) \\leftrightarrow s\n$$",
        "text_format": "latex",
        "bbox": [
            470,
            244,
            557,
            263
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\n\\int_ {0 _ {-}} ^ {\\infty} \\delta^ {\\prime} (t) e ^ {- s t} d t = - \\left[ e ^ {- s t} \\right] ^ {\\prime} | _ {t = 0} = - \\left[ - s e ^ {- s t} \\right] _ {t = 0} = s\n$$",
        "text_format": "latex",
        "bbox": [
            295,
            272,
            732,
            313
        ],
        "page_idx": 3
    },
    {
        "type": "text",
        "text": "3、阶跃信号的 LT",
        "bbox": [
            144,
            323,
            310,
            341
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\nu (t) \\rightarrow \\frac {1}{s}\n$$",
        "text_format": "latex",
        "bbox": [
            470,
            344,
            557,
            380
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\n\\int_ {0 _ {-}} ^ {\\infty} u (t) e ^ {- s t} d t = \\int_ {0} ^ {\\infty} e ^ {- s t} d t = \\frac {e ^ {- s t}}{- s} \\bigg | _ {0} ^ {\\infty} = 0 + \\frac {1}{s} = \\frac {1}{s}, \\sigma > 0\n$$",
        "text_format": "latex",
        "bbox": [
            240,
            387,
            756,
            430
        ],
        "page_idx": 3
    },
    {
        "type": "text",
        "text": "4、直流分量的 LT",
        "bbox": [
            144,
            439,
            310,
            456
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\n\\begin{array}{c} E \\leftrightarrow \\frac {E}{s} \\\\ \\int_ {0} ^ {\\infty} E \\cdot e ^ {- s t} d t = \\frac {E}{s} \\end{array}\n$$",
        "text_format": "latex",
        "bbox": [
            430,
            460,
            598,
            536
        ],
        "page_idx": 3
    },
    {
        "type": "text",
        "text": "5、单边 $e$ 指数的LT",
        "bbox": [
            144,
            536,
            321,
            554
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\ne ^ {- \\alpha t} u (t) \\leftrightarrow \\frac {1}{s + \\alpha}\n$$",
        "text_format": "latex",
        "bbox": [
            420,
            558,
            578,
            595
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\n\\int_ {0 _ {-}} ^ {\\infty} e ^ {- \\alpha t} u (t) e ^ {- s t} d t = \\int_ {0} ^ {\\infty} e ^ {- (s + \\alpha) t} d t = \\frac {1}{s + \\alpha}, \\sigma > - \\alpha\n$$",
        "text_format": "latex",
        "bbox": [
            258,
            600,
            739,
            642
        ],
        "page_idx": 3
    },
    {
        "type": "text",
        "text": "学习目的：逆变换 $\\rightarrow$ 联想（时域分析时解形式）",
        "bbox": [
            147,
            675,
            566,
            693
        ],
        "page_idx": 3
    },
    {
        "type": "header",
