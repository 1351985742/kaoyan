            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\mathrm{即} x (n) = \\frac {1}{2} S a (\\frac {\\pi}{2} n) - \\frac {1}{8} S a (\\frac {\\pi}{8} n)",
                "math_type": "latex",
