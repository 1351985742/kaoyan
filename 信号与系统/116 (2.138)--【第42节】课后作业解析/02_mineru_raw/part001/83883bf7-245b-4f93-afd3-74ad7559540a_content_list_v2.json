        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\frac {\\sin (\\frac {\\pi}{8} n)}{\\pi n} = \\frac {1}{8} \\frac {\\sin (\\frac {\\pi}{8} n)}{\\frac {\\pi}{8} n} = \\frac {1}{8} \\sin (\\frac {\\pi}{8} n)",
                "math_type": "latex",
