        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {\\frac {\\sin (\\frac {\\pi}{2} n)}{\\pi n}} & {= \\frac {1}{2} \\cdot \\frac {\\sin (\\frac {\\pi}{2} n)}{\\frac {\\pi}{2} n}} \\\\ & {= \\frac {1}{2} \\operatorname{Sal} (\\frac {\\pi}{2} n)} \\end{array}",
                "math_type": "latex",
                "image_source": {
