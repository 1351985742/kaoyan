        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "x [ n ] = \\frac {s i n (\\frac {\\pi}{2} n) - s i n (\\frac {\\pi}{8} n)}{\\pi n}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/837f2d0d91d40fcfcb6b3738920a33a83e0483c508b0c0ec022c7ea723fcdd43.jpg"
