        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "器，求其输出信号  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y[n]"
                    },
                    {
                        "type": "text",
                        "content": " 的频谱  "
