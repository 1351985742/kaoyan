                "math_content": "\\begin{array}{r l} {h _ {\\pm} (n)} & {= \\left[ (\\sqrt {n}) \\cdot (- 1) ^ {n} \\right] * h _ {1} (n) \\cdot (- 1) ^ {n}} \\\\ & {= [ \\sqrt {n}) * h _ {1} (n) ] \\cdot (- 1) ^ {n} = (- 1) ^ {n} h _ {1} (n)} \\end{array}",
                "math_type": "latex",
