                "image_footnote": []
            },
            "bbox": [
                266,
                206,
                741,
                372
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "其中  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\left| {2a}\\right|  < 1 \\Rightarrow  \\frac{1}{2} < a < \\frac{1}{2}"
                    }
                ]
            },
            "bbox": [
                751,
                227,
                986,
                261
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {H _ {2} (z)} & {= \\frac {1}{1 - \\frac {1}{4} z} = \\frac {- 4}{z - 4}} \\\\ & {= \\sqrt {\\frac {- 4 z}{z - 4}} \\cdot z ^ {- 1}} \\\\ & {A (4) ^ {n} (1 - n - 1)} \\end{array}",
