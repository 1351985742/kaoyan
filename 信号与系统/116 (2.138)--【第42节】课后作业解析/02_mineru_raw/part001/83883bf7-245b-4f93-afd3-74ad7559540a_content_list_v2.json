        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(1) 求输入的傅里叶变换  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "X(e^{j\\omega})"
