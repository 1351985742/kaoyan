        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "某线性时不变系统如下图所示，已知："
                    }
                ]
            },
            "bbox": [
                143,
                116,
                488,
                135
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "H _ {1} (e ^ {j \\omega}) = \\frac {1}{a - \\frac {1}{2} e ^ {j \\omega}}, H _ {2} (e ^ {j \\omega}) = \\frac {1}{1 - \\frac {1}{4} e ^ {j \\omega}}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/c12d07e9beb8c4f83b933bad2595d38eb8d69c3071b4874b4d8c988d61970a8b.jpg"
                }
            },
            "bbox": [
                308,
                142,
                687,
                193
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {(1) H _ {1} (z)} & {= \\frac {1}{a - \\frac {1}{2} z} = \\frac {- 2}{z - 2 a}} \\\\ & {= \\sqrt {\\frac {- 2 z}{z - 2 a}} \\cdot z ^ {- 1}} \\\\ & {= 2 (2 a) ^ {n} u (n)} \\end{array}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/c1ed1cd3588aafb33936f48f5ef91f8b91aabe3af4d24eb82e1bb01b4e5718b0.jpg"
                }
            },
            "bbox": [
                704,
                61,
                965,
                163
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Hle  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "^{my}"
                    },
                    {
                        "type": "text",
                        "content": " \n介存在"
                    }
                ]
            },
            "bbox": [
                950,
                171,
                1000,
                208
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {\\therefore h _ {1} (n)} & {= - 2 (2 a) ^ {n - 1} u (n - 1)} \\\\ & {= - 2 ^ {n} a ^ {n - 1} u (n - 1)} \\end{array}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/123e5bc73659fb1a1c5a9abb82c0801ffb657892615b6a345df78b781d82a373.jpg"
                }
            },
            "bbox": [
