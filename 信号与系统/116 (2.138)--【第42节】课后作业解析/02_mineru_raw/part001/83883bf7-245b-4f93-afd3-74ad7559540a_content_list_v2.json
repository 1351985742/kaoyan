                    {
                        "type": "equation_inline",
                        "content": "H(e^{j\\omega})"
                    },
                    {
                        "type": "text",
                        "content": " 为截止频率为  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{\\pi}{4}"
