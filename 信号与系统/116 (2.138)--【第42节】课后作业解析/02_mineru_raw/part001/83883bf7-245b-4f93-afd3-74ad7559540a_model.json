                0.688,
                0.194
            ],
            "angle": 0,
            "content": "\\[\nH _ {1} (e ^ {j \\omega}) = \\frac {1}{a - \\frac {1}{2} e ^ {j \\omega}}, H _ {2} (e ^ {j \\omega}) = \\frac {1}{1 - \\frac {1}{4} e ^ {j \\omega}}\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.705,
                0.062,
                0.966,
                0.164
            ],
            "angle": 0,
            "content": "\\[\n\\begin{array}{r l} {(1) H _ {1} (z)} & {= \\frac {1}{a - \\frac {1}{2} z} = \\frac {- 2}{z - 2 a}} \\\\ & {= \\sqrt {\\frac {- 2 z}{z - 2 a}} \\cdot z ^ {- 1}} \\\\ & {= 2 (2 a) ^ {n} u (n)} \\end{array}\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.951,
                0.172,
                1.0,
                0.209
            ],
            "angle": 0,
            "content": "Hle \\( ^{my} \\) \n介存在",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.716,
                0.164,
                0.941,
                0.228
            ],
            "angle": 0,
            "content": "\\[\n\\begin{array}{r l} {\\therefore h _ {1} (n)} & {= - 2 (2 a) ^ {n - 1} u (n - 1)} \\\\ & {= - 2 ^ {n} a ^ {n - 1} u (n - 1)} \\end{array}\n\\]"
        },
        {
            "type": "image",
            "bbox": [
                0.267,
                0.208,
                0.742,
                0.373
            ],
            "angle": 0,
            "content": null
        },
        {
            "type": "text",
            "bbox": [
                0.753,
                0.228,
                0.988,
                0.262
            ],
            "angle": 0,
            "content": "其中 \\( \\left| {2a}\\right|  < 1 \\Rightarrow  \\frac{1}{2} < a < \\frac{1}{2} \\)",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.748,
                0.259,
                0.986,
                0.379
            ],
            "angle": 0,
            "content": "\\[\n\\begin{array}{r l} {H _ {2} (z)} & {= \\frac {1}{1 - \\frac {1}{4} z} = \\frac {- 4}{z - 4}} \\\\ & {= \\sqrt {\\frac {- 4 z}{z - 4}} \\cdot z ^ {- 1}} \\\\ & {A (4) ^ {n} (1 - n - 1)} \\end{array}\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.894,
                0.362,
                0.987,
                0.387
            ],
            "angle": 0,
            "content": "\\[\n4 (4) ^ {n} u (- n - 1)\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.155,
                0.404,
                0.672,
                0.425
            ],
            "angle": 0,
            "content": "(1) 求 \\(H_{1}(e^{j\\omega})\\) 和 \\(H_{2}(e^{j\\omega})\\) 表示的两个系统的冲激响应 \\(h(n)\\);",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.706,
                0.376,
                0.88,
                0.448
            ],
            "angle": 0,
            "content": "\\[\n\\begin{array}{r l} {h _ {2} (n)} & {= 4 (4) ^ {n - 1} u (- n)} \\\\ & {= 4 ^ {n} u (- n)} \\end{array}\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.894,
                0.386,
