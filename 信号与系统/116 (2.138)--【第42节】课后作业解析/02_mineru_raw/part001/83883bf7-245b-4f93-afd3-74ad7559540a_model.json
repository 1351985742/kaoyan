                0.756,
                0.494
            ],
            "angle": 0,
            "content": "(2)  \\( \\frac{y}{3}x(n)=\\sqrt{n} \\)  时  \\( y(n)=h(n) \\)",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.909,
                0.452,
                0.994,
                0.476
            ],
            "angle": 0,
            "content": "\\( H_{2}(e^{i\\omega})\\pi_{3}\\pi \\)",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.156,
                0.487,
                0.461,
                0.506
            ],
            "angle": 0,
            "content": "(4) 画出系统的直接型模拟框图。",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.509,
                0.497,
                0.71,
                0.528
            ],
            "angle": 0,
            "content": "\\[\nh (n) = h _ {\\mathrm{上}} (n) + h _ {\\mathrm{下}} (n)\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.026,
                0.513,
                0.439,
                0.565
            ],
            "angle": 0,
            "content": "\\[\n1 3) H (2) = \\frac {- 2 z - 8 (a + 1)}{z ^ {2} + (2 a - 4) z - 8 a} = \\frac {- 2 z ^ {- 1} - 8 (a + 1) z ^ {- 2}}{1 + (2 a - 4) z ^ {- 1} - 8 a z ^ {- 2}}\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.482,
                0.533,
                0.531,
                0.567
            ],
            "angle": 0,
            "content": "其中",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.024,
                0.581,
                0.509,
                0.627
            ],
            "angle": 0,
            "content": "\\[\n\\Rightarrow y (n) + (2 a - 4) y (n - 1) - 8 a y (n - 2) = - 2 x (n - 1) - 8 (a + 1) x (n - 2)\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.531,
                0.524,
                0.934,
                0.615
            ],
            "angle": 0,
            "content": "\\[\n\\begin{array}{r l} {h _ {\\pm} (n)} & {= \\left[ (\\sqrt {n}) \\cdot (- 1) ^ {n} \\right] * h _ {1} (n) \\cdot (- 1) ^ {n}} \\\\ & {= [ \\sqrt {n}) * h _ {1} (n) ] \\cdot (- 1) ^ {n} = (- 1) ^ {n} h _ {1} (n)} \\end{array}\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.072,
                0.647,
                0.319,
                0.711
            ],
            "angle": 0,
            "content": "\\[\nH (2) = \\frac {- 2 z ^ {- 1} - 8 (a + 1) z ^ {- 2}}{1 - [ - (2 a - 4) z ^ {- 1} + 8 a z ^ {- 2} ]}\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.484,
                0.619,
                0.964,
                0.727
            ],
            "angle": 0,
            "content": "\\[\n\\begin{array}{r l} {h _ {\\mathrm{下}} (n)} & {= h _ {2} (n)} \\\\ {\\therefore h (n)} & {= (- 1) ^ {n} h _ {1} (n) + h _ {2} (n) \\Rightarrow H (2) = H _ {1} (- 2) + H _ {2} (2)} \\\\ & {= \\frac {- 2}{- 2 - 2 a} + \\frac {- 4}{2 - 4} = \\frac {- 2 2 - 8 (a + 1)}{(2 + 2 a) (2 - 4)}} \\end{array}\n\\]"
        },
