        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\n\\begin{array}{r l} {\\therefore h _ {1} (n)} & {= - 2 (2 a) ^ {n - 1} u (n - 1)} \\\\ & {= - 2 ^ {n} a ^ {n - 1} u (n - 1)} \\end{array}\n$$",
        "text_format": "latex",
        "bbox": [
            715,
            163,
            939,
