    },
    {
        "type": "text",
        "text": "其中 $\\left| {2a}\\right|  < 1 \\Rightarrow  \\frac{1}{2} < a < \\frac{1}{2}$",
        "bbox": [
            751,
            227,
            986,
            261
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\n\\begin{array}{r l} {H _ {2} (z)} & {= \\frac {1}{1 - \\frac {1}{4} z} = \\frac {- 4}{z - 4}} \\\\ & {= \\sqrt {\\frac {- 4 z}{z - 4}} \\cdot z ^ {- 1}} \\\\ & {A (4) ^ {n} (1 - n - 1)} \\end{array}\n$$",
        "text_format": "latex",
        "bbox": [
            746,
            258,
            985,
            378
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\n4 (4) ^ {n} u (- n - 1)\n$$",
        "text_format": "latex",
        "bbox": [
            893,
