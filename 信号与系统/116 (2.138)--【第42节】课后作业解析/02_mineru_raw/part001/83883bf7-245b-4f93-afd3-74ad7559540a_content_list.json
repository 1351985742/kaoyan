            505
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\nh (n) = h _ {\\mathrm{上}} (n) + h _ {\\mathrm{下}} (n)\n$$",
        "text_format": "latex",
        "bbox": [
            508,
