        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\n1 3) H (2) = \\frac {- 2 z - 8 (a + 1)}{z ^ {2} + (2 a - 4) z - 8 a} = \\frac {- 2 z ^ {- 1} - 8 (a + 1) z ^ {- 2}}{1 + (2 a - 4) z ^ {- 1} - 8 a z ^ {- 2}}\n$$",
        "text_format": "latex",
        "bbox": [
            24,
            512,
            437,
            564
        ],
        "page_idx": 3
    },
    {
        "type": "text",
        "text": "其中",
        "bbox": [
            480,
            532,
            529,
            566
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\n\\Rightarrow y (n) + (2 a - 4) y (n - 1) - 8 a y (n - 2) = - 2 x (n - 1) - 8 (a + 1) x (n - 2)\n$$",
        "text_format": "latex",
        "bbox": [
            22,
            580,
            508,
            626
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\n\\begin{array}{r l} {h _ {\\pm} (n)} & {= \\left[ (\\sqrt {n}) \\cdot (- 1) ^ {n} \\right] * h _ {1} (n) \\cdot (- 1) ^ {n}} \\\\ & {= [ \\sqrt {n}) * h _ {1} (n) ] \\cdot (- 1) ^ {n} = (- 1) ^ {n} h _ {1} (n)} \\end{array}\n$$",
        "text_format": "latex",
        "bbox": [
            529,
            523,
            933,
            613
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\nH (2) = \\frac {- 2 z ^ {- 1} - 8 (a + 1) z ^ {- 2}}{1 - [ - (2 a - 4) z ^ {- 1} + 8 a z ^ {- 2} ]}\n$$",
        "text_format": "latex",
        "bbox": [
            71,
            646,
            318,
            710
        ],
        "page_idx": 3
    },
    {
        "type": "equation",
        "text": "$$\n\\begin{array}{r l} {h _ {\\mathrm{下}} (n)} & {= h _ {2} (n)} \\\\ {\\therefore h (n)} & {= (- 1) ^ {n} h _ {1} (n) + h _ {2} (n) \\Rightarrow H (2) = H _ {1} (- 2) + H _ {2} (2)} \\\\ & {= \\frac {- 2}{- 2 - 2 a} + \\frac {- 4}{2 - 4} = \\frac {- 2 2 - 8 (a + 1)}{(2 + 2 a) (2 - 4)}} \\end{array}\n$$",
        "text_format": "latex",
        "bbox": [
            483,
            618,
            962,
            726
        ],
        "page_idx": 3
    },
