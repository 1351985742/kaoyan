                0.366,
                0.552,
                0.386
            ],
            "angle": 0,
            "content": "考点 2：网络拓扑关系——KCL 和 KVL",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.145,
                0.401,
                0.845,
                0.419
            ],
            "angle": 0,
            "content": "1、基尔霍夫电流定律 KCL——对于任一结点，流入电流之和等于流出电流之和",
            "merge_prev": false
        },
        {
            "type": "image",
            "bbox": [
                0.397,
                0.426,
                0.603,
                0.548
            ],
            "angle": 0,
            "content": null
        },
        {
            "type": "equation",
            "bbox": [
                0.447,
                0.555,
                0.551,
                0.572
            ],
            "angle": 0,
            "content": "\\[\ni _ {1} = i _ {2} + i _ {3}\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.144,
                0.577,
                0.801,
                0.594
            ],
            "angle": 0,
            "content": "2、基尔霍夫电压定律 KVL——对应闭环回路，沿回路绕行电压代数和为 0",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.193,
                0.608,
                0.438,
                0.628
            ],
            "angle": 0,
            "content": "\\[\n+ u _ {s _ {2}} - u _ {R _ {2}} - u _ {s _ {1}} + u _ {R _ {1}} = 0\n\\]"
        },
        {
            "type": "image",
            "bbox": [
                0.149,
                0.63,
                0.463,
                0.823
            ],
            "angle": 0,
            "content": null
        },
        {
            "type": "equation",
            "bbox": [
                0.519,
                0.609,
                0.772,
                0.629
            ],
            "angle": 0,
            "content": "\\[\n- u _ {R _ {1}} + u _ {s _ {1}} + u _ {R _ {2}} - u _ {s _ {2}} = 0\n\\]"
        },
        {
            "type": "image",
            "bbox": [
                0.476,
                0.632,
                0.787,
                0.794
            ],
            "angle": 0,
            "content": null
        },
        {
            "type": "equation",
            "bbox": [
                0.556,
                0.803,
                0.782,
                0.823
            ],
            "angle": 0,
            "content": "\\[\nu _ {s _ {1}} - u _ {R _ {1}} - u _ {s _ {2}} + u _ {R _ {2}} = 0\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.147,
                0.827,
                0.397,
                0.844
            ],
            "angle": 0,
            "content": "各支路电压的代数和等于零",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.26,
                0.851,
                0.451,
                0.87
            ],
            "angle": 0,
            "content": "\\[\nu _ {s _ {1}} + u _ {R _ {2}} = u _ {R _ {1}} + u _ {s _ {2}}\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.545,
                0.851,
                0.736,
                0.869
            ],
            "angle": 0,
            "content": "\\[\nu _ {R _ {1}} + u _ {s _ {2}} = u _ {s _ {1}} + u _ {R _ {2}}\n\\]"
        },
        {
            "type": "text",
            "bbox": [
