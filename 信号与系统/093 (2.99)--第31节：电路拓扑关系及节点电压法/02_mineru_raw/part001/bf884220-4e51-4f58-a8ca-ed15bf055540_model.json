                0.851,
                0.656,
                0.87
            ],
            "angle": 0,
            "content": "自导×本节点电压+Σ互导×相邻节点电压= \\( \\sum I_{s}+\\sum U_{sk}G_{sk} \\)",
            "merge_prev": false
        },
