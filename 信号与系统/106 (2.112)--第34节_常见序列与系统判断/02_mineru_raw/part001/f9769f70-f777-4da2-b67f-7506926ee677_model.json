        },
        {
            "type": "text",
            "bbox": [
                0.146,
                0.118,
                0.331,
                0.136
            ],
            "angle": 0,
            "content": "(1) \\( \\delta(n) \\) 与 \\( u(n) \\) 关系：",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.235,
                0.142,
                0.761,
                0.194
            ],
            "angle": 0,
            "content": "\\[\nu (n) = \\sum_ {m = 0} ^ {\\infty} \\delta (n - m) = \\sum_ {i = - \\infty} ^ {n} \\delta (i), \\delta (n) = u (n) - u (n - 1)\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.147,
                0.202,
                0.343,
                0.221
            ],
            "angle": 0,
            "content": "(2) \\(\\delta (n)\\) 与 \\(R_{N}(n)\\) 关系：",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.395,
                0.228,
                0.602,
                0.281
            ],
            "angle": 0,
            "content": "\\[\nR _ {N} (n) = \\sum_ {m = 0} ^ {N - 1} \\delta (n - m)\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.148,
                0.289,
                0.343,
                0.307
            ],
            "angle": 0,
            "content": "(3) \\( u(n) \\) 与 \\( R_{N}(n) \\) 关系：",
            "merge_prev": false
        },
        {
            "type": "page_number",
            "bbox": [
                0.946,
                0.967,
