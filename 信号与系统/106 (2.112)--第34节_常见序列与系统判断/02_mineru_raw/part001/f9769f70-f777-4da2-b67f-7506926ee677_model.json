            ],
            "angle": 0,
            "content": "(1)等间隔采样： \\( T_{s} \\)",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.145,
                0.208,
                0.427,
                0.226
            ],
            "angle": 0,
            "content": "\\( nT_{s} \\) 表示时间，而n仅表示序号。",
