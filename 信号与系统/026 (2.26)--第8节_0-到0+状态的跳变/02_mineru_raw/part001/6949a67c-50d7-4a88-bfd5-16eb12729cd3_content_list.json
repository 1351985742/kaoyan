    {
        "type": "text",
        "text": "【梦马班点拨】0\\_到0\\_+跳变的补充说明",
        "text_level": 2,
        "bbox": [
            191,
            108,
            502,
            124
        ],
        "page_idx": 5
    },
    {
        "type": "equation",
        "text": "$$\nr ^ {(n)} (0 _ {-}) \\xrightarrow {k \\text {组} , n = 0 , 1 \\cdots , k - 1} r ^ {(n)} (0 _ {+})\n$$",
        "text_format": "latex",
        "bbox": [
