        },
        {
            "type": "equation",
            "bbox": [
                0.303,
                0.826,
                0.734,
                0.864
            ],
            "angle": 0,
            "content": "\\[\n\\left\\{ \\begin{array}{c} y (0 -) = y (0 +) - a = 8 - 6 = 2 \\\\ y ^ {\\prime} (0 -) = y ^ {\\prime} (0 +) - (- 1 5) = - 8 - 9 + 1 5 = - 2 \\end{array} \\right.\n\\]"
