        {
            "type": "text",
            "bbox": [
                0.183,
                0.373,
                0.811,
                0.417
            ],
            "angle": 0,
            "content": "设初始 \\( y''(0_{-})=5,\\quad y'(0_{-})=-1,\\quad y(0_{-})=1 \\) ，输入为 \\( 3e^{-t}u(t) \\) ，求零输入响应 \\( y_{zi}(t) \\) ，零状态响应 \\( y_{zs}(t) \\) ，全响应 \\( y(t) \\) 。",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.168,
                0.419,
                0.491,
                0.459
            ],
            "angle": 0,
            "content": "解:设中间度量9(10),如图示",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.218,
                0.437,
                0.866,
                0.565
            ],
            "angle": 0,
            "content": "\\[\n\\begin{array}{r l} {q ^ {\\prime \\prime} (t)} & {= f (t) - 7 q ^ {\\prime \\prime} (t) - 1 0 q ^ {\\prime} (t) \\Rightarrow f (t) = q ^ {\\prime \\prime} (t) + 7 q ^ {\\prime \\prime} (t) + 1 0 q ^ {\\prime} (t)} \\\\ {y (t)} & {= 5 q (t) + 5 q ^ {\\prime} (t)} \\end{array}\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.183,
                0.571,
                0.365,
                0.61
            ],
            "angle": 0,
            "content": "\\( \\Rightarrow \\) 微分方程为",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.404,
                0.555,
                0.83,
                0.613
            ],
            "angle": 0,
            "content": "\\[\ny ^ {\\prime \\prime} | t | + 7 y ^ {\\prime \\prime} | t | + 1 0 y | t | = 5 f | t | + 5 f | t |\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.249,
                0.596,
                0.906,
                0.656
            ],
            "angle": 0,
            "content": "\\[\n\\alpha^ {3} + 7 \\alpha^ {2} + 1 0 \\alpha = \\alpha (\\alpha^ {2} + 7 \\alpha + 1 0) = \\alpha (\\alpha + 2) (\\alpha + 5) = 0\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.281,
                0.654,
                0.606,
                0.691
            ],
            "angle": 0,
            "content": "\\[\n\\alpha_ {1} = 0, \\alpha_ {2} = - 2, \\alpha_ {3} = - 5\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.241,
                0.68,
                0.854,
                0.738
            ],
            "angle": 0,
            "content": "\\[\ny _ {2 i} (t) = A _ {1} e ^ {0 t} + A _ {2} e ^ {- 2 t} + A _ {3} e ^ {- 5 t} = A _ {1} + A _ {2} e ^ {- 2 t} + A _ {3} e ^ {- 5 t}\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.241,
                0.74,
                0.579,
                0.776
            ],
            "angle": 0,
            "content": "\\[\ny _ {2 1} (0 +) = y (0 -) = A _ {1} + A _ {2} + A _ {3} = 1\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.242,
                0.773,
                0.58,
                0.814
            ],
            "angle": 0,
            "content": "\\[\ny _ {2 1} ^ {\\prime} (v + 1) = y ^ {\\prime} (v - 1) = - 2 A _ {2} - 5 A _ {3} = - 1\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.241,
                0.81,
                0.58,
                0.849
            ],
            "angle": 0,
            "content": "\\[\ny _ {2 1} ^ {\\prime \\prime} (0 + 1) = y ^ {\\prime \\prime} (0) = 4 A _ {2} + 2 5 A _ {3} = 5\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.719,
                0.795,
                0.814,
                0.834
            ],
            "angle": 0,
            "content": "\\[\nA _ {3} = \\frac {1}{5}\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.279,
                0.844,
                0.633,
                0.884
            ],
            "angle": 0,
            "content": "\\[\ny _ {i} (t) = (\\frac {4}{5} + \\frac {1}{5} e ^ {- 5 t}) u (t)\n\\]"
        },
