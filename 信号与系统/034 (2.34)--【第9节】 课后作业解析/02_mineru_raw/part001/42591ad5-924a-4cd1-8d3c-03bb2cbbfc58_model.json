        },
        {
            "type": "equation",
            "bbox": [
                0.407,
                0.754,
                0.632,
                0.784
            ],
            "angle": 0,
            "content": "\\[\n\\left\\{ \\begin{array}{c} a = 6 \\\\ b + 5 a = 1 5 \\end{array} \\right. \\Rightarrow \\left\\{ \\begin{array}{c} a = 6 \\\\ b = - 1 5 \\end{array} \\right.\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.142,
                0.796,
                0.178,
                0.813
            ],
            "angle": 0,
            "content": "则：",
