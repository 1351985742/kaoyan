                612
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\alpha^ {3} + 7 \\alpha^ {2} + 1 0 \\alpha = \\alpha (\\alpha^ {2} + 7 \\alpha + 1 0) = \\alpha (\\alpha + 2) (\\alpha + 5) = 0",
                "math_type": "latex",
                "image_source": {
                    "path": "images/3e69162abef00fe2393c6e2d62b250e3412dfea050f591eadee9e8aecf5a7c9b.jpg"
                }
            },
            "bbox": [
                248,
