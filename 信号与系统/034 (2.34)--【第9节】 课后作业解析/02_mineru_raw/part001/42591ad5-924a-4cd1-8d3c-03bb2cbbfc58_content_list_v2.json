        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {q ^ {\\prime \\prime} (t)} & {= f (t) - 7 q ^ {\\prime \\prime} (t) - 1 0 q ^ {\\prime} (t) \\Rightarrow f (t) = q ^ {\\prime \\prime} (t) + 7 q ^ {\\prime \\prime} (t) + 1 0 q ^ {\\prime} (t)} \\\\ {y (t)} & {= 5 q (t) + 5 q ^ {\\prime} (t)} \\end{array}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/3edf2149f4cbecfdf6cf0b56fce54b866132fb1f51533d2f18e556045974b511.jpg"
