                "math_content": "\\begin{array}{r l} {(3)} & {y | t | = y _ {2 i} | t | + y _ {x} | t |} \\\\ & {= (- 6 e ^ {- t} + 6 e ^ {- \\frac {1}{2} t} + e ^ {- 3 t}) (u | t)} \\end{array}",
