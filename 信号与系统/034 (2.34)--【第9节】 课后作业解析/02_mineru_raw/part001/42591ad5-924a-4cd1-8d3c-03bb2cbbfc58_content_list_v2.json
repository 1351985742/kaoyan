        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "y _ {2 1} ^ {\\prime \\prime} (0 + 1) = y ^ {\\prime \\prime} (0) = 4 A _ {2} + 2 5 A _ {3} = 5",
                "math_type": "latex",
                "image_source": {
