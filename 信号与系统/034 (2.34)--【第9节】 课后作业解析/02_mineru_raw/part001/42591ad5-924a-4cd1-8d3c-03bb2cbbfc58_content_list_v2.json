                905,
                655
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\alpha_ {1} = 0, \\alpha_ {2} = - 2, \\alpha_ {3} = - 5",
                "math_type": "latex",
                "image_source": {
                    "path": "images/a3970ed7269741d570f60b3c0119f0fe8d5f8cd15152dd48eba519dd9c426544.jpg"
                }
            },
            "bbox": [
