        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "y _ {2 i} (t) = A _ {1} e ^ {0 t} + A _ {2} e ^ {- 2 t} + A _ {3} e ^ {- 5 t} = A _ {1} + A _ {2} e ^ {- 2 t} + A _ {3} e ^ {- 5 t}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/f823378ccb8d0c551e20bb969c1d3b8cd5497b8e8cc71b9187bb559e48d71130.jpg"
                }
            },
            "bbox": [
                240,
                679,
                853,
                737
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "y _ {2 1} (0 +) = y (0 -) = A _ {1} + A _ {2} + A _ {3} = 1",
                "math_type": "latex",
                "image_source": {
                    "path": "images/23f871220f8054eb70f2782b24c2bdfea3a5698a896fc61b8a532f3d6e7ba36e.jpg"
                }
            },
            "bbox": [
                240,
