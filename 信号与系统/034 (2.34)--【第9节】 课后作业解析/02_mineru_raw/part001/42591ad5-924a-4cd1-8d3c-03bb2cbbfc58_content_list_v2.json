        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "设初始  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y''(0_{-})=5,\\quad y'(0_{-})=-1,\\quad y(0_{-})=1"
                    },
                    {
                        "type": "text",
