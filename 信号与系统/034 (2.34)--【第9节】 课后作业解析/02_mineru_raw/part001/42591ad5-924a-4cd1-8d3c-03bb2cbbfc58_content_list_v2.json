            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "y ^ {\\prime \\prime} | t | + 7 y ^ {\\prime \\prime} | t | + 1 0 y | t | = 5 f | t | + 5 f | t |",
                "math_type": "latex",
                "image_source": {
                    "path": "images/c1b938bb1426e0136df5d8bc43fdbffb1f7b2de2c7acb387b55408b84c58f939.jpg"
                }
            },
            "bbox": [
                403,
                554,
