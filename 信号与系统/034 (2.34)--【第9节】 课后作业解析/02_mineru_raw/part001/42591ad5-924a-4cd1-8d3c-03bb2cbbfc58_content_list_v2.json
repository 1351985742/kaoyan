            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "y _ {2 1} ^ {\\prime} (v + 1) = y ^ {\\prime} (v - 1) = - 2 A _ {2} - 5 A _ {3} = - 1",
                "math_type": "latex",
                "image_source": {
                    "path": "images/f15ed9c81420d7c46b790f87088f62f0d1542e5c31a4d4e78002e498d5d4de39.jpg"
                }
            },
            "bbox": [
