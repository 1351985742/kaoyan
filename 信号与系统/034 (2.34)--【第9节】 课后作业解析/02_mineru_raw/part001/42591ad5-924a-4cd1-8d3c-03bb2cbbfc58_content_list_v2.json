            "bbox": [
                406,
                108,
                594,
                127
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1、【2024 武汉工程大学 4.4】设系统输入信号为  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x(t)"
                    },
                    {
                        "type": "text",
                        "content": ", 输出信号为  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y(t)"
                    },
                    {
                        "type": "text",
                        "content": ", 因果LTI 系统的微分方程如下:  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y''(t) + \\frac{3}{2} y'(t) + \\frac{1}{2} y(t) = 5x(t)"
                    },
                    {
                        "type": "text",
                        "content": ", 已知  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y(0^-) = 1"
                    },
                    {
                        "type": "text",
                        "content": ",  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y'(0^-) ="
                    }
                ]
            },
            "bbox": [
                184,
                136,
                813,
                185
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "0,  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x(t) = e^{-3t}u(t)"
                    },
                    {
                        "type": "text",
                        "content": ", 求:"
                    }
                ]
            },
            "bbox": [
                184,
                192,
                383,
                211
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(1) 求零输入响应  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{zi}(t)"
                    },
                    {
                        "type": "text",
                        "content": ";"
                    }
                ]
            },
            "bbox": [
                193,
                217,
                394,
                235
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(2) 求零状态响应  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{zs}(t)"
                    },
                    {
                        "type": "text",
                        "content": " ;"
                    }
                ]
            },
            "bbox": [
                193,
                241,
                396,
                260
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(3) 求全响应  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y(t)"
                    },
                    {
                        "type": "text",
                        "content": " 。"
                    }
                ]
            },
            "bbox": [
                194,
                266,
                349,
                283
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "解:  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\alpha^{2}+\\frac{3}{2}\\alpha+\\frac{1}{2}=(\\alpha+1)(\\alpha+\\frac{1}{2})=0"
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\alpha_{1}=-1, \\quad \\alpha_{2}=-\\frac{1}{2}"
                    }
                ]
            },
            "bbox": [
                450,
                185,
                808,
                244
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(1)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{2i}|t| = Ae^{-t} + Be^{-\\frac{1}{2}t}"
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{2i}(t+1) = y_{10-1} = A + B = 1"
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{2i}(t+1) = y_{10-1} = -A - \\frac{1}{2}B = 0 \\Rightarrow \\begin{cases} A = -1 \\\\ B = 2 \\end{cases}"
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\therefore y_{2i}(t) = (-e^{-t} + 2e^{-\\frac{1}{2}t})u(t)"
                    },
                    {
                        "type": "text",
                        "content": " \n\n(2)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{2sh}(t) = Ce^{-t} + De^{-\\frac{1}{2}t}"
                    },
                    {
                        "type": "equation_inline",
                        "content": "5x(t) = 5e^{-3t}u(t)"
                    },
                    {
                        "type": "text",
                        "content": "  自由项\n\n  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "t > 0"
                    },
                    {
                        "type": "text",
                        "content": "  时自由项   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "= 5e^{-3t}"
                    },
                    {
                        "type": "text",
                        "content": " ，故   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{2xp}(t) = Ee^{-3t}"
                    },
                    {
                        "type": "equation_inline",
                        "content": "9Ee^{-3t} - \\frac{9}{2}Ee^{-3t} + \\frac{9}{2}e^{-3t} = 5e^{-3t}"
                    },
                    {
                        "type": "text",
                        "content": " \n\nE = 1\n\n  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{xp}(t) = e^{-3t}"
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{x}(t) = Ce^{-t} + De^{-\\frac{1}{2}t} + e^{-3t}"
                    },
                    {
                        "type": "text",
                        "content": " \n\n自由项中无   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\delta(t)"
                    },
                    {
                        "type": "text",
                        "content": "  或   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\delta(t)"
                    },
                    {
                        "type": "text",
                        "content": "  参际项，故无初始化\n\n即   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{x}(t+1) = y_{x}(t-1) = C + D + 1 = 0"
                    },
                    {
                        "type": "equation_inline",
                        "content": "y'_{x}(t+1) = y'_{x}(t-1) = -C - \\frac{1}{2}D - 3 = 0"
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\Rightarrow C = -5, D = 4"
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\Rightarrow y_{x}(t) = (-5e^{-t} + 4e^{-\\frac{1}{2}t} + e^{-3t})u(t)"
                    }
                ]
            },
            "bbox": [
                485,
