            42
        ],
        "page_idx": 0
    },
    {
        "type": "page_number",
        "text": "29",
        "bbox": [
            489,
            928,
            509,
            940
        ],
        "page_idx": 0
    },
    {
        "type": "footer",
        "text": "官网：tongxinkaoyan.com",
        "bbox": [
            117,
