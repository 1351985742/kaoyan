            354,
            973
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "考点2：网络函数的应用",
        "text_level": 2,
        "bbox": [
            146,
            85,
            408,
            105
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "(1)求零状态",
        "bbox": [
            146,
            117,
            260,
            136
        ],
        "page_idx": 1
    },
    {
        "type": "equation",
        "text": "$$\nY _ {z s} (\\omega) = F (\\omega) \\cdot H (\\omega) \\stackrel {\\text {逆变换}} {\\rightarrow} y _ {z s} (t)\n$$",
        "text_format": "latex",
        "bbox": [
            351,
            146,
            642,
            175
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "(2)与直流卷积",
        "bbox": [
            146,
            206,
            282,
            225
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "(3)与 $e$ 指数卷积",
        "bbox": [
            146,
            309,
            292,
            329
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "(4)与 $cos\\omega_0t$ 卷积",
        "bbox": [
            147,
            438,
            302,
            457
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "夢馬考研",
        "bbox": [
            425,
            502,
            601,
            539
        ],
        "page_idx": 1
    },
    {
        "type": "header",
        "text": "B站up：信号与系统\\_谷哥",
        "bbox": [
            115,
            24,
            344,
            43
        ],
        "page_idx": 1
    },
    {
        "type": "header",
        "text": "公众号：通信考研小马哥",
        "bbox": [
            653,
            24,
            880,
            42
        ],
        "page_idx": 1
    },
    {
        "type": "page_number",
        "text": "30",
        "bbox": [
            489,
            928,
            509,
            940
        ],
        "page_idx": 1
    },
    {
        "type": "footer",
        "text": "梦马班讲义",
        "bbox": [
            774,
            954,
            880,
            973
        ],
        "page_idx": 1
