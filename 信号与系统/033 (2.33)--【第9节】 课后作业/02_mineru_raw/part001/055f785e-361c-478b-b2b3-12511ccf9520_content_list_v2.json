                    },
                    {
                        "type": "text",
                        "content": " ，已知  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x(t) = 3(1 + e^{-t})u(t)"
                    },
                    {
                        "type": "text",
                        "content": " ，其中全响应  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y(t) = (4e^{-2t} + 3e^{-3t} + 1)u(t)"
                    }
                ]
            },
