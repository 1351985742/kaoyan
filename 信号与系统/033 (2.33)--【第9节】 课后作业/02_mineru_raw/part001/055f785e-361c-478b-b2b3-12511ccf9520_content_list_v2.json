            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(3) 求全响应  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y(t)"
                    },
                    {
                        "type": "text",
                        "content": " 。"
                    }
