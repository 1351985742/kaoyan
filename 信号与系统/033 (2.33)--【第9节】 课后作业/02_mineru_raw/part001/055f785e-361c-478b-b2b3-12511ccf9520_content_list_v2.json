            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1、【2024 武汉工程大学 4.4】设系统输入信号为  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x(t)"
                    },
                    {
                        "type": "text",
                        "content": "，输出信号为  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y(t)"
                    },
                    {
                        "type": "text",
                        "content": "，因果LTI 系统的微分方程如下： "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y''(t) + \\frac{3}{2} y'(t) + \\frac{1}{2} y(t) = 5x(t)"
                    },
                    {
                        "type": "text",
                        "content": "，已知  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y(0^-) = 1"
                    },
                    {
                        "type": "text",
                        "content": "， "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y'(0^-) = 0"
                    },
                    {
                        "type": "text",
                        "content": "， "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x(t) = e^{-3t}u(t)"
                    },
                    {
                        "type": "text",
                        "content": "，求："
                    }
                ]
            },
            "bbox": [
                184,
                137,
                811,
                211
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(1) 求零输入响应  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{zi}(t)"
                    },
                    {
                        "type": "text",
                        "content": " ;"
                    }
                ]
            },
            "bbox": [
                193,
                218,
                393,
                235
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(2) 求零状态响应  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y_{zs}(t)"
                    },
                    {
                        "type": "text",
                        "content": " ;"
                    }
                ]
            },
            "bbox": [
                194,
