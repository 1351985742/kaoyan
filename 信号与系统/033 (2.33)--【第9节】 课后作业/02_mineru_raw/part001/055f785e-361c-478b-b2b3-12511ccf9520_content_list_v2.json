                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "3、【2024重庆大学6.2】已知某LTI系统,  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y''(t)+5y'(t)+6y(t)=x''(t)+3x'(t)+"
                    }
                ]
