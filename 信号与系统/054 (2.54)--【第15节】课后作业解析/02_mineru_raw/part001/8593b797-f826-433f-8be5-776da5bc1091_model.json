                0.268
            ],
            "angle": 0,
            "content": null
        },
        {
            "type": "equation",
            "bbox": [
                0.276,
                0.268,
                0.352,
                0.293
            ],
            "angle": 0,
            "content": "\\[\nT = I\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.266,
                0.29,
                0.538,
                0.342
            ],
            "angle": 0,
            "content": "\\[\na _ {0} = \\frac {S _ {T}}{T} = \\frac {2 \\times 1 0}{5} = 4\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.254,
                0.343,
                0.697,
                0.397
            ],
            "angle": 0,
            "content": "\\( {hw}_{1} \\rightarrow  {w}_{1} \\) 间隔 \\( {w}_{1} = \\frac{2\\pi }{T} = \\frac{2\\pi }{5} \\)",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.145,
                0.531,
                0.851,
                0.59
            ],
            "angle": 0,
            "content": "6、周期信号  \\( f(t)=\\sum_{n=-\\infty}^{\\infty}\\delta(t-2n+1) \\) ，其中  \\( \\delta(t) \\)  是单位冲激信号，该周期信号指数形式傅里叶级数为  \\( \\frac{1}{n}=\\sum_{n=-\\infty}^{\\infty}(-1)^{n}e^{j\\pi n t} \\)",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.372,
                0.608,
                0.465,
                0.641
            ],
            "angle": 0,
            "content": "\\[\n\\delta (t - 2 n)\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.484,
                0.605,
                0.565,
                0.644
            ],
            "angle": 0,
            "content": "面积为",
            "merge_prev": false
        },
        {
            "type": "image",
            "bbox": [
                0.581,
                0.578,
                0.838,
                0.667
            ],
            "angle": 0,
            "content": null
        },
        {
            "type": "text",
            "bbox": [
                0.295,
                0.695,
                0.65,
                0.747
            ],
            "angle": 0,
            "content": "\\(\\sum_{n=-\\infty}^{\\infty}\\delta(t+1-2n)\\) 左移1个单位",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.306,
                0.757,
                0.605,
                0.802
            ],
            "angle": 0,
            "content": "T不变 T=2. W=π",
            "merge_prev": false
        },
        {
            "type": "image",
            "bbox": [
                0.675,
