            ],
            "angle": 0,
            "content": null
        },
        {
            "type": "equation",
            "bbox": [
                0.304,
                0.802,
                0.912,
                0.858
            ],
            "angle": 0,
            "content": "\\[\nF _ {n} = \\frac {1}{T _ {1}} \\int_ {\\pi_ {1}} f (t) e ^ {- j n m t} d t = \\frac {1}{2} \\int_ {0} ^ {2} \\delta (t - 1) e ^ {- j n \\pi t} d t\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.142,
                0.87,
                0.404,
                0.96
            ],
            "angle": 0,
            "content": "\\[\n\\begin{array}{r l} {f (t)} & {= \\sum_ {n = - \\infty} ^ {\\infty} F _ {n} e ^ {j n m t}} \\\\ & {= \\sum_ {n = - \\infty} ^ {\\infty} \\frac {1}{2} (- 1) ^ {n} e ^ {j n \\pi t}} \\end{array}\n\\]"
        },
