            "content": "7、如图，实周期 \\( x(t) \\) ，求其傅里叶级数。",
            "merge_prev": false
        },
        {
            "type": "image",
            "bbox": [
                0.33,
                0.117,
                0.668,
                0.217
            ],
            "angle": 0,
            "content": null
        },
        {
            "type": "text",
            "bbox": [
                0.239,
                0.226,
                0.515,
                0.272
            ],
            "angle": 0,
            "content": "\\( {T}_{1} = 2,{W}_{1} = \\frac{2\\pi }{{T}_{1}} = \\pi \\)",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.241,
                0.278,
                0.776,
                0.361
            ],
            "angle": 0,
            "content": "无直流  \\( F_{0}=a_{0}=0 \\) \n\n奇对称  \\( \\Rightarrow a_{n}=0 \\)   \\( \\Rightarrow F_{n}=-\\frac{1}{2}b_{n} \\)  经应形式",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.248,
                0.366,
                0.651,
                0.468
            ],
            "angle": 0,
            "content": "\\[\n\\begin{array}{r l} {F _ {n}} & {= \\frac {1}{T _ {1}} \\int_ {T _ {1}} ^ {1} f (t) e ^ {- j n w _ {1} t} d t} \\\\ & {= \\frac {1}{2} \\int_ {- 1} ^ {1} t e ^ {- j n w _ {1} t} d t = j \\frac {(- 1) ^ {n}}{n \\pi}} \\end{array}\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.246,
                0.489,
                0.792,
                0.606
            ],
            "angle": 0,
            "content": "\\[\n\\therefore x (t) = \\sum_ {n = - v _ {0}} ^ {\\infty} f _ {n} e ^ {j n w _ {1} t} = \\left\\{ \\begin{array}{l l} 0, & n = 0 \\\\ \\sum_ {n = - v _ {0}} ^ {\\infty} \\frac {j (- 1) ^ {n}}{n \\pi} e ^ {j n \\pi t}, & n \\neq 0 \\end{array} \\right.\n\\]"
        },
