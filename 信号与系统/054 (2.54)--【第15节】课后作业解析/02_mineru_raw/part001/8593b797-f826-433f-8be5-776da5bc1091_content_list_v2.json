                    {
                        "type": "equation_inline",
                        "content": "F_{n}=\\frac{1}{T_{0}}\\int_{T_{0}}x(-\\frac{1}{2}t+3)e^{-jnW_{0}t}dt"
                    },
                    {
                        "type": "text",
                        "content": "\n\n求的  "
