                        "type": "equation_inline",
                        "content": "F_{n'}=\\frac{1}{T_{1}}\\int_{T_{1}}x(t)e^{-jnW_{1}t}dt"
                    },
                    {
                        "type": "text",
                        "content": "\n\n未知  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "=\\frac{2}{T_{0}}\\int_{-\\frac{T_{1}}{2}}^{\\frac{T_{1}}{2}}x(t)e^{-jn2w_{0}t}dt"
                    },
                    {
                        "type": "text",
                        "content": "\n\n可知  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "t=\\frac{-1}{2}a+3"
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{2}{T_{0}}\\int_{6+T_{1}}^{6-T_{1}}x(-\\frac{a}{2}+3)e^{-jn2w_{0}(-\\frac{a}{2}+3)}d(-\\frac{a}{2})"
                    },
