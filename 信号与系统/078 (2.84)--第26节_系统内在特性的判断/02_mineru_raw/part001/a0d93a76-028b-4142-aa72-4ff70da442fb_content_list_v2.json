            "bbox": [
                144,
                567,
                628,
                585
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "①求系统函数   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "H(s)"
                    },
                    {
                        "type": "text",
                        "content": "  的零极点，并画出零极点分布图；"
