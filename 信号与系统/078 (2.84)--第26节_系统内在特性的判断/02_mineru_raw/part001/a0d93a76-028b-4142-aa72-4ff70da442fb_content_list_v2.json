            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "相频特性   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\varphi(\\omega)=\\left(\\text{所有零点夹角之和}\\right)-\\left(\\text{所有极点夹角之和}\\right)"
                    }
                ]
            },
            "bbox": [
                146,
                699,
                657,
                720
            ]
        },
        {
            "type": "paragraph",
            "content": {
