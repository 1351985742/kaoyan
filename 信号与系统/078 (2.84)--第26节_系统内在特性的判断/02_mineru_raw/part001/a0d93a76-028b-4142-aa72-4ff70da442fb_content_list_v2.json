            },
            "bbox": [
                144,
                624,
                608,
                642
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "③幅频特性  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\left|H(\\omega)\\right|=\\frac{所有零点线段长度乘积}{所有极点线段长度乘积}"
                    }
                ]
            },
            "bbox": [
                144,
                653,
                534,
                690
            ]
        },
