    {
        "type": "equation",
        "text": "$$\n\\cos \\theta = \\frac {e ^ {j \\theta} + e ^ {- j \\theta}}{2}, \\sin \\theta = \\frac {e ^ {j \\theta} - e ^ {- j \\theta}}{2 j}\n$$",
        "text_format": "latex",
        "bbox": [
