    {
        "type": "equation",
        "text": "$$\ny ^ {\\prime \\prime} (t) + 5 y ^ {\\prime} (t) + 5 y (t) = 5 x (t)\n$$",
        "text_format": "latex",
        "bbox": [
            568,
            381,
            947,
            428
        ],
        "page_idx": 8
    },
    {
        "type": "text",
        "text": "那个公式",
        "bbox": [
            228,
            423,
            457,
            475
        ],
        "page_idx": 8
    },
    {
        "type": "equation",
        "text": "$$\nH (s) = \\frac {Y (s)}{x (s)} = \\frac {\\frac {1}{S C}}{R + S L + \\frac {1}{S C}} = \\frac {5}{s ^ {2} + 5 s + 5}\n$$",
        "text_format": "latex",
        "bbox": [
            571,
            419,
            975,
            485
        ],
        "page_idx": 8
    },
    {
        "type": "text",
        "text": "不带n的，摇生",
        "bbox": [
