    [
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "考点3：系统函数的应用"
                    }
                ],
                "level": 2
            },
            "bbox": [
                147,
                85,
                406,
                105
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1、求解系统方程  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "H(s)=\\frac{R_{zs}(s)}{E(s)}=\\frac{右边形式}{左边形式}"
                    }
                ]
            },
            "bbox": [
                144,
                118,
                495,
                147
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "2、求解系统的冲激响应：  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "H(s)\\xrightarrow{\\text{逆变换}}h(t)"
                    }
                ]
            },
            "bbox": [
                144,
                158,
                539,
                175
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "3、求解系统的阶跃响应：  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "G(s)=\\frac{H(s)}{s}\\xrightarrow{\\text{逆变换}}g(t)"
                    }
                ]
            },
            "bbox": [
                144,
                187,
                601,
                222
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "4、求解系统的零状态响应：  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "R_{zs}(s)=H(s)\\cdot E(s)\\xrightarrow{\\text{逆变换}}r_{zs}(t)"
                    }
                ]
            },
            "bbox": [
                144,
                233,
                677,
                253
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "例 18: 已知微分方程   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "r''(t) + 3r'(t) + 2r(t) = e'(t) + 3e(t)"
                    },
                    {
                        "type": "text",
                        "content": " ，  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "e(t) = e^{-4t}u(t)"
                    },
                    {
                        "type": "text",
                        "content": " ，求   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "h(t)"
                    },
                    {
                        "type": "text",
                        "content": " 、  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "g(t)"
                    },
                    {
                        "type": "text",
                        "content": " 、  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "r_{zs}(t)"
                    },
                    {
                        "type": "text",
                        "content": " 。"
                    }
                ]
            },
            "bbox": [
                144,
                290,
                847,
                341
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "5、求解系统某一特征值的复频域响应"
                    }
                ]
            },
            "bbox": [
                146,
                476,
                484,
                494
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "若输入为  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "e^{s_0t}"
                    },
                    {
                        "type": "text",
                        "content": "，则对应输出为  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "H(s_0)e^{s_0t}"
                    },
                    {
                        "type": "text",
                        "content": " 【要求  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "s_0"
                    },
                    {
                        "type": "text",
                        "content": " 在ROC内， "
                    },
                    {
                        "type": "equation_inline",
                        "content": "s_0"
                    },
                    {
                        "type": "text",
                        "content": " 为复常数】，当  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "s_0 = 0"
                    },
                    {
                        "type": "text",
                        "content": " 时，输入为直流信号  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "E = E \\cdot e^{0 \\cdot t}"
                    },
                    {
                        "type": "text",
                        "content": " (E看为系数)，则对应的输出  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "E \\cdot H(0) \\cdot e^{0 \\cdot t} = E \\cdot H(0)"
                    }
                ]
            },
            "bbox": [
                147,
                505,
                776,
                589
            ]
        },
