                102
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "若激励为   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "e(t)=E_{m}\\sin(\\omega_{0}t)"
                    },
                    {
                        "type": "text",
                        "content": "  或   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "e(t)=E_{m}\\cos(\\omega_{0}t)"
                    }
                ]
            },
            "bbox": [
                144,
                111,
                541,
                131
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "则系统稳态响应结果：  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "r_{ss}(t)=E_{m}H_{0}\\sin(\\omega_{0}t+\\varphi_{0})"
                    },
                    {
                        "type": "text",
                        "content": "  或   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "r_{ss}(t)=E_{m}H_{0}\\cos(\\omega_{0}t+\\varphi_{0})"
                    }
                ]
            },
            "bbox": [
                146,
                142,
                801,
                162
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(4)稳态响应的求解步骤:"
                    }
                ]
            },
            "bbox": [
                146,
                174,
                371,
                191
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "①根据  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "e(t)"
                    },
                    {
                        "type": "text",
                        "content": " 明确  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "E_{m}"
                    },
                    {
                        "type": "text",
                        "content": " 和  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\omega_{0}"
                    },
                    {
                        "type": "text",
                        "content": " 的大小"
                    }
                ]
            },
            "bbox": [
                144,
                200,
                426,
                219
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "②  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "H(j\\omega_{0})=H(s)/s=j\\omega_{0}"
                    },
                    {
                        "type": "text",
                        "content": " ，将  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "H(j\\omega_{0})"
                    },
                    {
                        "type": "text",
                        "content": " 化成一个复数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z=a+bj"
                    },
                    {
                        "type": "text",
                        "content": " （明确实部和虚部）"
                    }
                ]
            },
            "bbox": [
                144,
                230,
                848,
                263
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "③  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "H_{0} = \\left|H(j\\omega_{0})\\right|"
                    },
                    {
                        "type": "text",
                        "content": "， "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\varphi_{0}"
                    },
                    {
                        "type": "text",
                        "content": " 为相角【 "
                    },
                    {
                        "type": "equation_inline",
                        "content": "z = a + bj"
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\quad |z| = \\sqrt{(a^2 + b^2)}"
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\quad \\varphi = \\arctan{\\frac{b}{a}}"
                    },
                    {
                        "type": "text",
                        "content": "】"
                    }
                ]
            },
            "bbox": [
                146,
                278,
                806,
                311
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "④将  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "E_{m},\\omega_{0},H_{0},\\varphi_{0}"
                    },
                    {
                        "type": "text",
                        "content": " 带入结论。"
                    }
                ]
            },
