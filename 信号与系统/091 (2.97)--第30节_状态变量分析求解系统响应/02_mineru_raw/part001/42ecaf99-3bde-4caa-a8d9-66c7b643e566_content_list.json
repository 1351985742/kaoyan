    {
        "type": "text",
        "text": "考点1：求解系统响应",
        "text_level": 2,
        "bbox": [
            144,
            120,
            384,
            140
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "状态方程标准形式为",
        "bbox": [
            144,
            152,
            332,
            168
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\n\\dot {\\lambda} (t) = A \\lambda (t) + B e (t)\n$$",
        "text_format": "latex",
        "bbox": [
            415,
            183,
            579,
            208
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "输出方程为",
        "bbox": [
            146,
            216,
            252,
            233
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\nr (t) = C \\lambda (t) + D e (t)\n$$",
        "text_format": "latex",
        "bbox": [
            418,
            242,
            579,
            263
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\n\\dot {\\lambda} (t) = A \\lambda (t) + B e (t) \\Rightarrow s \\lambda (s) - \\lambda (0 _ {-}) = A \\lambda (s) + B E (s) \\Rightarrow (s I - A) \\lambda (s) = \\lambda (0 _ {-}) + B E (s)\n$$",
        "text_format": "latex",
        "bbox": [
            157,
            275,
            838,
            300
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "令 $\\phi (s) = (sI - A)^{-1}$ 称为状态转移矩阵，则",
        "bbox": [
            147,
            311,
            505,
            331
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\n\\lambda (s) = \\phi (s) [ \\lambda (0 _ {-}) + B E (s) ]\n$$",
        "text_format": "latex",
        "bbox": [
            391,
            340,
            606,
            361
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "输出方程",
        "bbox": [
            147,
            370,
            233,
            386
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\n\\begin{array}{r l} r (t) & = C \\lambda (t) + D e (t) \\Rightarrow R (s) = C \\lambda (s) + D E (s) = C \\phi (s) [ \\lambda (0 _ {-}) + B E (s) ] + D E (s) \\\\ R (s) & = C \\phi (s) \\lambda (0 _ {-}) + [ C \\phi (s) B + D ] E (s) \\\\ & \\quad \\Downarrow \\quad \\quad \\quad \\quad \\quad \\quad \\quad \\quad \\quad \\quad \\Downarrow \\\\ & = R _ {z i} (s) + R _ {z s} (s) \\end{array}\n$$",
        "text_format": "latex",
        "bbox": [
            191,
            395,
            805,
            493
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "可见，系统函数",
        "bbox": [
            147,
            500,
            292,
            517
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\nH (s) = C \\phi (s) B + D\n$$",
        "text_format": "latex",
        "bbox": [
            416,
