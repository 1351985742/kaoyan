        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} r (t) & = C \\lambda (t) + D e (t) \\Rightarrow R (s) = C \\lambda (s) + D E (s) = C \\phi (s) [ \\lambda (0 _ {-}) + B E (s) ] + D E (s) \\\\ R (s) & = C \\phi (s) \\lambda (0 _ {-}) + [ C \\phi (s) B + D ] E (s) \\\\ & \\quad \\Downarrow \\quad \\quad \\quad \\quad \\quad \\quad \\quad \\quad \\quad \\quad \\Downarrow \\\\ & = R _ {z i} (s) + R _ {z s} (s) \\end{array}",
