            ],
            "angle": 0,
            "content": "\\[\n\\left\\{ \\begin{array}{l} \\dot {\\boldsymbol {\\lambda}} (t) = \\boldsymbol {A} \\boldsymbol {\\lambda} (t) + \\boldsymbol {B} \\boldsymbol {e} (t) \\\\ \\boldsymbol {r} (t) = \\boldsymbol {C} \\boldsymbol {\\lambda} (t) \\end{array} \\right.\n\\]"
        },
