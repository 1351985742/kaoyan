        },
        {
            "type": "text",
            "bbox": [
                0.146,
                0.153,
                0.334,
                0.17
            ],
            "angle": 0,
            "content": "状态方程标准形式为",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.416,
                0.184,
                0.581,
                0.209
            ],
            "angle": 0,
            "content": "\\[\n\\dot {\\lambda} (t) = A \\lambda (t) + B e (t)\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.147,
                0.217,
                0.253,
                0.234
            ],
            "angle": 0,
            "content": "输出方程为",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.419,
                0.243,
                0.581,
                0.265
            ],
            "angle": 0,
            "content": "\\[\nr (t) = C \\lambda (t) + D e (t)\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.158,
                0.277,
                0.839,
                0.302
            ],
            "angle": 0,
            "content": "\\[\n\\dot {\\lambda} (t) = A \\lambda (t) + B e (t) \\Rightarrow s \\lambda (s) - \\lambda (0 _ {-}) = A \\lambda (s) + B E (s) \\Rightarrow (s I - A) \\lambda (s) = \\lambda (0 _ {-}) + B E (s)\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.148,
                0.312,
                0.507,
                0.332
            ],
            "angle": 0,
            "content": "令 \\(\\phi (s) = (sI - A)^{-1}\\) 称为状态转移矩阵，则",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.393,
                0.341,
                0.608,
                0.362
            ],
            "angle": 0,
            "content": "\\[\n\\lambda (s) = \\phi (s) [ \\lambda (0 _ {-}) + B E (s) ]\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.148,
                0.371,
                0.235,
                0.387
            ],
            "angle": 0,
            "content": "输出方程",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.193,
                0.396,
                0.806,
                0.494
            ],
            "angle": 0,
            "content": "\\[\n\\begin{array}{r l} r (t) & = C \\lambda (t) + D e (t) \\Rightarrow R (s) = C \\lambda (s) + D E (s) = C \\phi (s) [ \\lambda (0 _ {-}) + B E (s) ] + D E (s) \\\\ R (s) & = C \\phi (s) \\lambda (0 _ {-}) + [ C \\phi (s) B + D ] E (s) \\\\ & \\quad \\Downarrow \\quad \\quad \\quad \\quad \\quad \\quad \\quad \\quad \\quad \\quad \\Downarrow \\\\ & = R _ {z i} (s) + R _ {z s} (s) \\end{array}\n\\]"
        },
        {
            "type": "text",
            "bbox": [
                0.148,
                0.501,
                0.294,
                0.518
            ],
            "angle": 0,
            "content": "可见，系统函数",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.418,
                0.527,
                0.58,
                0.548
            ],
            "angle": 0,
            "content": "\\[\nH (s) = C \\phi (s) B + D\n\\]"
        },
