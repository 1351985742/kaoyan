        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "$(1)0_{-}$ 到 $0_{+}$ 发生跳变，不代表k组处处跳变，但至少有一组有跳变",
        "bbox": [
            184,
            163,
            707,
