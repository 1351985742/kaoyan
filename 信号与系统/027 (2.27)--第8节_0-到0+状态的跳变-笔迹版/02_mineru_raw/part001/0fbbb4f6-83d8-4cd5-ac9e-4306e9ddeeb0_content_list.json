    },
    {
        "type": "equation",
        "text": "$$\nr ^ {(n)} (0 _ {-}) \\xrightarrow {k \\text {组} , n = 0 , 1 \\cdots , k - 1} r ^ {(n)} (0 _ {+})\n$$",
        "text_format": "latex",
        "bbox": [
            374,
            134,
