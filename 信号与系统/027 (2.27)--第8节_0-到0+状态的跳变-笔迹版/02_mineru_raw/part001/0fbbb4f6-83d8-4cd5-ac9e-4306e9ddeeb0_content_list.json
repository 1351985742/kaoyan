            160
        ],
        "page_idx": 5
    },
    {
        "type": "equation",
        "text": "$$\nr ^ {\\prime} (0 +) = r ^ {\\prime} (0 -) + a _ {2} \\dots\n$$",
        "text_format": "latex",
        "bbox": [
            687,
