            },
            "bbox": [
                193,
                131,
                426,
                157
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(2)  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\int_{-\\infty}^{\\infty}\\cos \\left(\\frac{\\pi}{6} t\\right)\\delta '(t - 1)dt"
                    }
                ]
            },
            "bbox": [
                194,
                163,
                423,
                188
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "解: (1)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sqrt{\\left(\\frac{t}{3}+1\\right)} = 3\\sqrt{(t+3)}"
                    }
                ]
            },
            "bbox": [
                183,
                205,
                529,
                241
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {\\mathrm{故原式}} & {= \\int_ {- \\infty} ^ {\\infty} \\sin (\\frac {\\pi}{6} t) \\cdot 3 (\\sqrt {t + 3}) d t} \\\\ & {= 3 \\cdot \\sin [ \\frac {\\pi}{6} \\cdot (- 3) ]} \\\\ & {= 3 \\sin (- \\frac {\\pi}{2})} \\\\ & {= - 3} \\end{array}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/bf80b406b0fe455bf5ac88be91f4889cfdd6785c6461f3ea9472c51034716502.jpg"
                }
            },
            "bbox": [
                250,
                245,
                605,
                422
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {\\mathrm{原式}} & {= - \\left[ \\cos (\\frac {\\pi}{6} t) \\right] _ {t = 1} ^ {\\prime}} \\\\ & {= - \\left[ - \\frac {\\pi}{6} \\sin (\\frac {\\pi}{6} t) \\right] _ {t = 1}} \\\\ & {= \\frac {\\pi}{6} \\sin \\frac {\\pi}{6}} \\\\ & {= \\frac {\\pi}{1 2}} \\end{array}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/72d2b7bac350c7765e7db73a8260e9bddd6a33011725d385c8d670907fb7826d.jpg"
                }
