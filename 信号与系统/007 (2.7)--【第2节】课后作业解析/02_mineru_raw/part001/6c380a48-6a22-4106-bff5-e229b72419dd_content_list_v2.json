                    {
                        "type": "equation_inline",
                        "content": "\\int_{-\\infty}^{\\infty} \\sin \\left(\\frac{\\pi}{6} t\\right) \\delta \\left(\\frac{t}{3} + 1\\right) dt"
                    }
