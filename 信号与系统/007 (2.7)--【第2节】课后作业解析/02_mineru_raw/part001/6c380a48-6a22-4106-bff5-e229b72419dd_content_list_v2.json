            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "解：(1)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f_{0}|t|=\\frac{u|t|-u|-t|}{2}"
                    },
                    {
                        "type": "text",
                        "content": "  从同称为有   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{1}{2}\\sin u|t|"
                    }
                ]
            },
            "bbox": [
                161,
                205,
                660,
                260
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "(2)   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sin t = 0"
                    },
                    {
                        "type": "text",
                        "content": "  的根为   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "t = k\\pi"
                    },
                    {
                        "type": "text",
                        "content": " ,   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "k = 0, \\pm1, \\pm2 \\cdots"
                    }
                ]
            },
            "bbox": [
                210,
                273,
                689,
                307
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "(\\sin t) ^ {\\prime} = \\cos t",
                "math_type": "latex",
                "image_source": {
                    "path": "images/9481613344bad7ab3bedb4a2300f198db53348d160a87775ed4d6e96a53e34f8.jpg"
                }
            },
            "bbox": [
                260,
                315,
                401,
                353
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {\\mathrm{原式}} & {= \\sum \\frac {1}{| \\cos k \\pi |} \\delta (t - k \\pi)} \\\\ & {= \\sum \\delta (t - k \\pi), k = 0, \\pm 1, \\pm 2 \\dots} \\\\ & {= \\dots + \\delta (t + \\pi) + \\delta (t) + \\delta (t - \\pi) + \\delta (t - 2 \\pi) + \\dots} \\end{array}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/ca138137b589c1c6a03df583ff185ee7321cb2722c1d7a7e001a94ba80149ba5.jpg"
                }
            },
            "bbox": [
                270,
                361,
                702,
