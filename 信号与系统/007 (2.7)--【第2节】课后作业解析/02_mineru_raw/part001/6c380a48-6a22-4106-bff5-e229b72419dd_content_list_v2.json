            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "5、【2024年湖北工业大学1】已知   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x(4+2t)=\\delta(t)+e^{-2t-4}"
