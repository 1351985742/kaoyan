                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "2、【2024年武汉工程大学2.2】  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(t)=e^{-t}\\delta(t)"
                    },
                    {
                        "type": "text",
                        "content": " ，其导数  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{df(t)}{dt}"
                    },
                    {
                        "type": "text",
                        "content": " 为____，积分  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\int_{-\\infty}^{t}f(\\tau)d\\tau"
                    },
                    {
                        "type": "text",
                        "content": " 为____。"
                    }
                ]
            },
            "bbox": [
                181,
                110,
                811,
