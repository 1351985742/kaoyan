        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "解:  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(t) = e^{-t} \\delta (t) = \\delta (t)"
                    }
                ]
            },
            "bbox": [
                196,
                190,
                478,
                233
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "故   "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\frac{d f(t)}{dt} = \\delta'(t)"
                    }
                ]
            },
            "bbox": [
