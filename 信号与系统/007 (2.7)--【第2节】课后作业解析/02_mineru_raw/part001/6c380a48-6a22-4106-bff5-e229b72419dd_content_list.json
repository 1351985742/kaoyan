    {
        "type": "text",
        "text": "1、【2024年华侨大学1.1】计算 $\\int_{-\\infty}^{+\\infty} (\\sin \\pi x + 1) \\delta(x - 1) dx$",
        "bbox": [
            183,
            148,
            657,
            169
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "解:",
        "bbox": [
            196,
            174,
            238,
            211
        ],
        "page_idx": 0
    },
    {
        "type": "equation",
        "text": "$$\n\\begin{array}{r l} {\\mathrm{原式}} & {= [ \\sin \\pi x + 1 ] _ {x = 1}} \\\\ & {= \\sin \\pi + 1} \\\\ & {= 1} \\end{array}\n$$",
