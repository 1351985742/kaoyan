            ],
            "angle": 0,
            "content": "(1) \\(\\int_{-\\infty}^{\\infty} \\sin \\left(\\frac{\\pi}{6} t\\right) \\delta \\left(\\frac{t}{3} + 1\\right) dt\\)",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.195,
                0.164,
                0.424,
                0.189
            ],
            "angle": 0,
            "content": "(2) \\(\\int_{-\\infty}^{\\infty}\\cos \\left(\\frac{\\pi}{6} t\\right)\\delta '(t - 1)dt\\)",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.184,
                0.206,
                0.53,
                0.242
            ],
            "angle": 0,
            "content": "解: (1)  \\( \\sqrt{\\left(\\frac{t}{3}+1\\right)} = 3\\sqrt{(t+3)} \\)",
            "merge_prev": false
        },
        {
            "type": "equation",
            "bbox": [
                0.252,
                0.247,
                0.606,
                0.423
            ],
            "angle": 0,
            "content": "\\[\n\\begin{array}{r l} {\\mathrm{故原式}} & {= \\int_ {- \\infty} ^ {\\infty} \\sin (\\frac {\\pi}{6} t) \\cdot 3 (\\sqrt {t + 3}) d t} \\\\ & {= 3 \\cdot \\sin [ \\frac {\\pi}{6} \\cdot (- 3) ]} \\\\ & {= 3 \\sin (- \\frac {\\pi}{2})} \\\\ & {= - 3} \\end{array}\n\\]"
        },
        {
            "type": "equation",
            "bbox": [
                0.661,
                0.193,
                0.903,
                0.41
            ],
            "angle": 0,
            "content": "\\[\n\\begin{array}{r l} {\\mathrm{原式}} & {= - \\left[ \\cos (\\frac {\\pi}{6} t) \\right] _ {t = 1} ^ {\\prime}} \\\\ & {= - \\left[ - \\frac {\\pi}{6} \\sin (\\frac {\\pi}{6} t) \\right] _ {t = 1}} \\\\ & {= \\frac {\\pi}{6} \\sin \\frac {\\pi}{6}} \\\\ & {= \\frac {\\pi}{1 2}} \\end{array}\n\\]"
        },
