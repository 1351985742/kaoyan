            ],
            "angle": 0,
            "content": "(1) \\( u\\left( t\\right) \\) 的奇分量 \\( = \\) ____.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.195,
                0.157,
                0.359,
                0.176
            ],
            "angle": 0,
            "content": "(2) \\(\\delta(sint) =\\)",
