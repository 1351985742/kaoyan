                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "解:  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "f(t) \\xrightarrow{\\text{右2}} f(t-2) \\xrightarrow{\\text{压缩}} f(2t-2)"
