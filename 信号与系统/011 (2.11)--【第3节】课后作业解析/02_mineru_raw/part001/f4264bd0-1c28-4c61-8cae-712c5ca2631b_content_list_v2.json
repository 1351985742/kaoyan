        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "①把多余的一2去掉 则  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x(-2t-2) \\rightarrow x(-2t+2-2) = x[-2(t-1)-2]"
                    },
                    {
                        "type": "text",
                        "content": "\n\n说明右1去掉-2"
                    }
                ]
            },
            "bbox": [
                117,
                637,
                818,
                705
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "② 把  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x(2t)"
                    },
                    {
                        "type": "text",
                        "content": " 中负号去掉 则  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x(-2t) \\rightarrow x(2t) = x[-2(-t)]"
                    },
                    {
                        "type": "text",
                        "content": " 反转"
                    }
                ]
            },
            "bbox": [
                117,
                720,
                739,
                809
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "③把  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x(x)"
                    },
                    {
                        "type": "text",
                        "content": " 中2去掉 则  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x(x)"
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\longrightarrow"
                    },
                    {
                        "type": "equation_inline",
                        "content": "x(2 \\cdot \\frac{t}{2}) = x(t)"
                    }
                ]
            },
