    {
        "type": "text",
        "text": "(1)零状态响应的求解",
        "bbox": [
            184,
            137,
            361,
            154
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "系统零状态响应=激励与单位冲激响应之卷积，即",
        "bbox": [
            184,
            161,
            581,
            179
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "证明过程:",
        "bbox": [
