            821,
            777
        ],
        "page_idx": 2
    },
    {
        "type": "equation",
        "text": "$$\ny _ {| t |} = y _ {h} (t) + y _ {p} (t) = A e ^ {- t} + B e ^ {- 2 t} - 5 e ^ {- 3 t}\n$$",
        "text_format": "latex",
        "bbox": [
            315,
            779,
