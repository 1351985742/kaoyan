        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {\\mathrm{则} 9 ^ {\\prime \\prime} | t |} & {= f | t | - 3 9 ^ {\\prime} | t | - 2 9 | t | \\Rightarrow f | t | = 9 ^ {\\prime \\prime} | t | + 3 9 ^ {\\prime} | t | + 2 9 | t |} \\\\ {y | t |} & {= 9 | t | + 2 9 ^ {\\prime} | t |} \\end{array}",
                "math_type": "latex",
