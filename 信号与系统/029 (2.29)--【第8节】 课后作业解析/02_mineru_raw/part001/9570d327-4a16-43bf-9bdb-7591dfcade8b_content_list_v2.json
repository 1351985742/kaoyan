        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {C e ^ {- t} - 5 C e ^ {- t} + 6 C e ^ {- t}} & {= - e ^ {- t}} \\\\ {2 C = - 1 \\Rightarrow C = - \\frac {1}{2}} \\end{array}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/233d95fccb8c0e3fef00cfeae389e7a16d63fe96d7896e40175c47de223cfe96.jpg"
                }
            },
            "bbox": [
                524,
                233,
                810,
                294
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "y _ {p} | t | = - \\frac {1}{2} e ^ {- t}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/a79ee229f5fbdf76486971b6f1b4a4bd38404cb99af8a380d68c8071cd70241c.jpg"
                }
            },
            "bbox": [
                616,
                298,
                764,
                336
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "y _ {| t |} = y _ {n} | t | + y _ {p} | t | = A e ^ {- x t} + B e ^ {- 3 t} - \\frac {1}{2} e ^ {- t}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/89d5e30e362c3204d4b6068329f756b90da99af99377bbb54a77e2be1f089095.jpg"
                }
            },
            "bbox": [
                332,
                339,
                714,
                382
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "y ^ {\\prime} (t) + 5 y ^ {\\prime} (t) + 6 y (t) = - e ^ {- t} u (t) + 2 d (t)",
                "math_type": "latex",
                "image_source": {
                    "path": "images/e7587b54233ec29d859dd7a8c1341db114bcf512601ed1a453bc3fe7d2ba4c12.jpg"
                }
            },
            "bbox": [
                408,
                378,
                732,
                422
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {y ^ {\\prime} (t)} & {= a d (t) + b \\Delta u (t) \\Rightarrow a = 2} \\\\ {y ^ {\\prime} (t)} & {= a \\Delta u (t) \\Rightarrow y ^ {\\prime} (0 + 1) = y ^ {\\prime} (0 - 1) + a = 3} \\\\ {y ^ {\\prime} (t)} & {= a d (\\Delta u (t) \\Rightarrow y (0 + 1) = y (0 - 1) = 1} \\end{array}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/865b941932eff2edbc31cbc91fc1b9887d5d931dd1ffe01fc6431037590a639d.jpg"
                }
            },
            "bbox": [
                436,
                423,
                769,
                524
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\left\\{ \\begin{array}{l} y (0 + 1) = A + B - \\frac {1}{2} = 1 \\\\ y ^ {\\prime} (0 + 1) = - 2 A - 3 B + \\frac {1}{2} = 3 \\end{array} \\right. \\Rightarrow \\left\\{ \\begin{array}{l} A = 7 \\\\ B = - \\frac {1 1}{2} \\end{array} \\right.",
                "math_type": "latex",
                "image_source": {
                    "path": "images/bf59887b011c405dc5ffd3ac56b7a6df045e192301e6ac7178455a9d019d908b.jpg"
                }
            },
            "bbox": [
                384,
                529,
                794,
                612
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "y _ {| t |} = (7 e ^ {- 2 t} - \\frac {1 1}{2} e ^ {- 3 t} - \\frac {1}{2} e ^ {- t}) u (t)",
                "math_type": "latex",
                "image_source": {
                    "path": "images/f27169c9169320e51496002bec726f26771e89e9aaec644944fe1e8549426822.jpg"
                }
