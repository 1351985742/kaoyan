                944,
                201
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\alpha_ {1} = - 2, \\quad \\alpha_ {2} = - 3",
                "math_type": "latex",
                "image_source": {
                    "path": "images/2015b9c0173d25dacabfaa15a209052cc728df4d0ba8b0d05b86531980c17870.jpg"
