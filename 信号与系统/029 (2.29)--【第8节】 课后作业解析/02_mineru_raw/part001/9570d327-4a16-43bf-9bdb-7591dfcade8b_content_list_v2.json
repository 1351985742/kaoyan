            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1、已知  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y''(t)+5y'(t)+6y(t)=2x'(t)+x(t)"
                    },
                    {
                        "type": "text",
                        "content": " ，  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "x(t)=e^{-t}u(t)"
                    },
                    {
                        "type": "text",
                        "content": " ，  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y(0_{-})="
                    }
                ]
            },
            "bbox": [
                183,
                138,
                766,
                157
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "equation_inline",
                        "content": "y'(0_{-})=1"
                    },
                    {
                        "type": "text",
                        "content": " ，求系统的全响应  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "y(t)"
                    },
                    {
                        "type": "text",
                        "content": " 。"
                    }
                ]
            },
            "bbox": [
                183,
                163,
                457,
                181
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\alpha^ {2} + 5 \\alpha + 6 = (\\alpha + 2) (\\alpha + 3) = 0",
                "math_type": "latex",
                "image_source": {
                    "path": "images/c4359d45cfdb150a16e38551e7a2ba9be8a8b90607003485cf29aabef2939520.jpg"
                }
            },
            "bbox": [
                218,
