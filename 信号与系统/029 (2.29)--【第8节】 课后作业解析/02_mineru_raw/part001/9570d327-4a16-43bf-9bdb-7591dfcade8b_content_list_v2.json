        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\left\\{ \\begin{array}{l} {r ^ {\\prime \\prime} (t) + 3 r ^ {\\prime} (t) + r (t) = \\sqrt {t}} \\\\ {r ^ {\\prime \\prime} (t) = a \\delta (t) + b \\Delta u (t)} \\Rightarrow a = 1 \\\\ {r ^ {\\prime} (t) = a \\Delta u (t)} \\Rightarrow r ^ {\\prime} (0 + 1) = r ^ {\\prime} (2) + a = 3 \\\\ {r ^ {\\prime} (t) = a t (\\Delta u (t)) \\Rightarrow r (2 t) = r (0 - 1) = 1} \\end{array} \\right.",
                "math_type": "latex",
