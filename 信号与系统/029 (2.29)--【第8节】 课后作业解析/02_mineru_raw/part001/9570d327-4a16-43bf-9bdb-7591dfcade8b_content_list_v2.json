        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {2 f (t) + f (t)} & {= 2 \\left[ - 6 e ^ {- 3 t} u (t) + 2 c (\\sqrt {t}) \\right] + 2 e ^ {- 3 t} u (t)} \\\\ & {= - 1 0 e ^ {- 3 t} u (t) + 4 \\sqrt {t}} \\end{array}",
