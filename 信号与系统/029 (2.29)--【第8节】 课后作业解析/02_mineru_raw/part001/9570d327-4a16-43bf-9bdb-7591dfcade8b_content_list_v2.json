        {
            "type": "equation_interline",
            "content": {
                "math_content": "r ^ {\\prime \\prime} (t) + 3 r ^ {\\prime} (t) + r (t) = e ^ {\\prime} (t) + 3 e (t)",
                "math_type": "latex",
                "image_source": {
