        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "equation_inline",
                        "content": "t > 0"
                    },
                    {
                        "type": "text",
                        "content": " 时自由项  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "=  - {e}^{ - t}"
                    },
                    {
                        "type": "text",
                        "content": " ,故选  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "{y}_{p}\\left( t\\right)  = C{e}^{-t}"
                    }
                ]
            },
            "bbox": [
                500,
                201,
                889,
                232
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "y _ {h} (t) = A e ^ {- 2 t} + B e ^ {- 3 t}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/6e345ab0ba1ec8738c8b50536a4302e24728748695fe8067255d846578cacb5b.jpg"
                }
            },
            "bbox": [
                218,
