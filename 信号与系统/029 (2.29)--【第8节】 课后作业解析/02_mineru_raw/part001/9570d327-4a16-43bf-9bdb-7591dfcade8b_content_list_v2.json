        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {e ^ {\\prime} (t) + 3 e (t)} & {= [ e ^ {- 3 t} u (t) ] ^ {\\prime} + 3 e ^ {- 3 t} u (t)} \\\\ & {= - 3 e ^ {- 3 t} u (t) + e ^ {- 3 t} \\delta (t) + 3 e ^ {- 3 t} u (t)} \\\\ & {= \\delta (t)} \\end{array}",
                "math_type": "latex",
