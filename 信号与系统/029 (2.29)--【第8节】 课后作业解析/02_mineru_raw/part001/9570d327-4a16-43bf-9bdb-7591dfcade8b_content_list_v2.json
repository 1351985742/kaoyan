            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{l} {(2) \\alpha^ {2} + 3 \\alpha + 2 = (\\alpha + 1) (\\alpha + 2) = 0} \\\\ {\\alpha_ {1} = - 1, \\quad \\alpha_ {2} = - 2} \\end{array}",
                "math_type": "latex",
                "image_source": {
                    "path": "images/924b05b4f79da91bbf5eef990f00b3fe971f91fd1674b8f84b4b3ec653975fb9.jpg"
