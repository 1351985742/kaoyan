                "math_content": "\\begin{array}{r l} {y (0 +)} & {= A + B - 5 = 1} \\\\ {y (2 +)} & {= - A - 2 B + 1 5 = 5} \\end{array} \\Rightarrow \\begin{array}{r l} {A} & {= 2} \\\\ {B} & {= 4} \\end{array}",
