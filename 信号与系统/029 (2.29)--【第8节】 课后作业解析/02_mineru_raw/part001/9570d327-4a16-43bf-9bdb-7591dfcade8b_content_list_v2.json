                465,
                207
            ]
        },
        {
            "type": "equation_interline",
            "content": {
                "math_content": "2 x ^ {\\prime} (t) + x (t) = 2 \\left[ - e ^ {- t} (u (t) + d (t)) \\right] + e ^ {- t} (u (t)) = - e ^ {t} (u (t) + 2 d (t))",
                "math_type": "latex",
                "image_source": {
                    "path": "images/c363b604fdf8796269fd4c54cf280e03db5425e7ef85724866f3f1931454e1f9.jpg"
                }
            },
            "bbox": [
                492,
