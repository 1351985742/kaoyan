        {
            "type": "equation_interline",
            "content": {
                "math_content": "\\begin{array}{r l} {9 c e ^ {- 3 t} - 9 c e ^ {- 3 t} + 2 c e ^ {- 3 t}} & {= - 1 0 e ^ {- 3 t}} \\\\ {2 c = - 1 0 \\Rightarrow c = - 5} \\end{array}",
                "math_type": "latex",
