        "page_idx": 1
    },
    {
        "type": "equation",
        "text": "$$\n\\left\\{ \\begin{array}{l} {y ^ {(k)} (0 _ {-}) \\Rightarrow y _ {z i} (t) + y _ {z s} (t) = y (t)} \\\\ {y ^ {(k)} (0 _ {+}) \\Rightarrow \\left\\{ \\begin{array}{l l} {y _ {z s} (t) \\stackrel {\\text {解形式}} {\\Longrightarrow} y (t) \\Rightarrow y _ {z i} (t) = y (t) - y _ {z s} (t)} \\\\ {y _ {z i} (t) \\text {含系数} \\Rightarrow y (t) = y _ {z i} (t) \\text {含系数} + y _ {z s} (t) \\stackrel {y ^ {(k)} (0 _ {+})} {\\Longrightarrow} y _ {z i} (t) \\Rightarrow y (t)} \\end{array} \\right.} \\end{array} \\right.\n$$",
        "text_format": "latex",
        "bbox": [
            191,
