        ],
        "page_idx": 5
    },
    {
        "type": "equation",
        "text": "$$\n\\lambda_ {1} (n + 1) = \\lambda_ {2} (n + 1) - \\lambda_ {2} (n)\n$$",
        "text_format": "latex",
        "bbox": [
            361,
            275,
            633,
            297
        ],
        "page_idx": 5
    },
    {
