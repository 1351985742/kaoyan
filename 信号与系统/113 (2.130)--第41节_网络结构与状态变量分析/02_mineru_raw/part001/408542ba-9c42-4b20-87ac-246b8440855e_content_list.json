    {
        "type": "equation",
        "text": "$$\nz \\lambda_ {1} (z) = z \\lambda_ {2} (z) - \\lambda_ {2} (z)\n$$",
        "text_format": "latex",
        "bbox": [
            391,
            254,
            605,
